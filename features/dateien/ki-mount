#!/usr/bin/python3 -I
"""/opt/ki/dateien/ki-mount – USB-Datenträger ein- und aushängen (per sudo ohne Passwort).

Erlaubt nur Partitionen von USB-/Wechseldatenträgern; Ziel ist immer /media/ki/<name>,
eingehängt mit nosuid,nodev. Aufruf: ki-mount liste | einbinden <gerät> | auswerfen <gerät>
"""
import json
import os
import re
import subprocess
import sys

BASE = "/media/ki"
FS_OK = {"vfat", "exfat", "ntfs", "ntfs3", "ext2", "ext3", "ext4", "btrfs", "xfs", "iso9660", "udf"}
FS_OWNER = {"vfat", "exfat", "ntfs", "ntfs3", "iso9660", "udf"}   # ohne Unix-Rechte: Besitzer setzen


def yes(v):
    return v in (True, 1, "1", "true")


def devices():
    out = subprocess.run(
        ["lsblk", "-J", "-p", "-o", "NAME,TYPE,TRAN,RM,HOTPLUG,FSTYPE,SIZE,LABEL,MOUNTPOINT"],
        capture_output=True, text=True, check=True).stdout
    for disk in json.loads(out).get("blockdevices", []):
        if not (disk.get("tran") == "usb" or yes(disk.get("rm")) or yes(disk.get("hotplug"))):
            continue
        for part in disk.get("children") or [disk]:
            if part.get("fstype") in FS_OK:
                yield part


def find(dev):
    for part in devices():
        if part["name"] == dev or part.get("mountpoint") == dev:
            return part
    sys.exit(f"ki-mount: {dev} ist kein USB-/Wechseldatenträger")


def mount(dev):
    part = find(dev)
    if part.get("mountpoint"):
        print(part["mountpoint"])
        return
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", part.get("label") or os.path.basename(part["name"])).strip("._") or "usb"
    target, n = os.path.join(BASE, name), 2
    while os.path.exists(target) and (os.path.ismount(target) or os.listdir(target)):
        target, n = os.path.join(BASE, f"{name}-{n}"), n + 1
    os.makedirs(target, exist_ok=True)
    opts = "nosuid,nodev"
    if part["fstype"] in FS_OWNER:
        uid, gid = os.environ.get("SUDO_UID", "0"), os.environ.get("SUDO_GID", "0")
        if not (uid.isdigit() and gid.isdigit()):
            sys.exit("ki-mount: ungültige Benutzerkennung")
        opts += f",uid={uid},gid={gid},umask=022"
    if subprocess.run(["mount", "-o", opts, part["name"], target]).returncode != 0:
        os.rmdir(target)
        sys.exit(f"ki-mount: {part['name']} ließ sich nicht einhängen")
    print(target)


def unmount(dev):
    part = find(dev)
    mp = part.get("mountpoint")
    if not mp:
        return
    if os.path.dirname(mp) != BASE:
        sys.exit(f"ki-mount: {mp} wurde nicht von ki eingehängt")
    subprocess.run(["sync"])
    if subprocess.run(["umount", mp]).returncode != 0:
        sys.exit("ki-mount: Datenträger ist noch in Benutzung (Dateimanager/Terminal dort geöffnet?)")
    os.rmdir(mp)


def main():
    cmd, arg = (sys.argv[1:] + ["", ""])[:2]
    if cmd == "liste":
        for p in devices():
            print("\t".join([p["name"], p.get("size") or "", p.get("label") or "-", p["fstype"], p.get("mountpoint") or ""]))
    elif cmd == "einbinden" and arg:
        mount(arg)
    elif cmd == "auswerfen" and arg:
        unmount(arg)
    else:
        sys.exit("Aufruf: ki-mount liste | einbinden <gerät> | auswerfen <gerät>")


if __name__ == "__main__":
    main()
