#!/usr/bin/env bash
# ki – der eine Befehl der KI-Workstation (das Menü "ki menu" baut darauf auf)
#
# Jedes Projekt ist ein Ordner unter ~/projects/<name>/. Für PyCharm, Terminal und Jobs
# blendet bubblewrap ("Kerker") ihn als Home-Verzeichnis ein:
#
#   ~/projects/<name>/             → ~             Caches, Dotfiles, .ki/ (Profil, Logs, Jobs)
#   ~/projects/<name>/code/        → ~/code        dein Code = PyCharm-Projektwurzel
#   ~/projects/<name>/code/.venv/  → ~/code/.venv  Interpreter-Pfad ist in jedem Projekt gleich
#
# Alles, was pip, PyCharm oder ein Training schreibt, landet im Projektordner oder im RAM.
# Befehle anderer Funktionen (ki menu, ki dateien, ki usb, ki top …) liegen in deren Ordner
# features/<name>/bin/ und werden hier nur weitergereicht, wenn die Funktion installiert ist.
#
# Bewusst ohne "set -e": Fehler werden gezielt behandelt, damit nie ein halber Zustand bleibt.
set -uo pipefail
shopt -s nullglob

KI_VERSION="3.0"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
REPO=$(cd "${SELF%/*}/../../.." && pwd)
KI_DIR="$HOME/.ki"

# ------------------------------------------------------------------ Einstellungen
# Alle Werte lassen sich in ~/.ki/basis/ki.conf überschreiben.
KI_PROJECTS="$HOME/projects"
KI_SHARED="$HOME/shared_data"
KI_PYCHARM="/opt/ki/pycharm/current"
KI_IDE_XMX="2048m"
KI_IDE_MAX=3                       # höchstens so viele PyCharm-Fenster gleichzeitig
KI_JUPYTER_PORT=8888
KI_USE_UV=auto
# shellcheck source=/dev/null
[ -f "$KI_DIR/basis/ki.conf" ] && . "$KI_DIR/basis/ki.conf"

KI_WS_MENU="1:Menü" KI_WS_IDE="2:IDE" KI_WS_EXTRA="3:Extra"   # wie in oberflaeche/i3.conf
KI_RUN="${XDG_RUNTIME_DIR:-/tmp/ki-$(id -u)}/ki"
KI_PC="$KI_DIR/pycharm"            # PyCharm-Einstellungen (Funktion pycharm)
KERKER=()
KERKER_ENV=()

if [ -t 1 ]; then
    C_ACC=$'\e[38;5;173m' C_OK=$'\e[38;5;107m' C_ERR=$'\e[38;5;210m' C_DIM=$'\e[2m' C_B=$'\e[1m' C_0=$'\e[0m'
else
    C_ACC='' C_OK='' C_ERR='' C_DIM='' C_B='' C_0=''
fi
info() { printf '%s›%s %s\n' "$C_ACC" "$C_0" "$*"; }
warn() { printf '%s!%s %s\n' "$C_ACC" "$C_0" "$*" >&2; }
die()  { printf '%s✘%s %s\n' "$C_ERR" "$C_0" "$*" >&2; exit 1; }
say_hint() { printf '  %s%s%s\n' "$C_DIM" "$*" "$C_0"; }

# ------------------------------------------------------------------ Hilfsfunktionen
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; }
proj_dir()   { printf '%s/%s' "$KI_PROJECTS" "$1"; }
has()        { [ -f "$KI_DIR/$1/.installed" ]; }          # ist die Funktion installiert?

need_project() {
    [ -n "${1:-}" ] || die "Projektname fehlt."
    valid_name "$1" || die "Ungültiger Projektname '$1' (erlaubt: a-z A-Z 0-9 - _)."
    [ -d "$(proj_dir "$1")" ] || die "Projekt '$1' gibt es nicht (anlegen: ki new $1)."
}
proj_profile() {
    local f; f="$(proj_dir "$1")/.ki/profile"
    if [ -f "$f" ]; then head -n1 "$f"; else echo py; fi
}
proj_last_used() {
    local P; P=$(proj_dir "$1")
    stat -c %Y "$P/.ki/last-used" 2>/dev/null || stat -c %Y "$P"
}
projects() {
    local d n
    for d in "$KI_PROJECTS"/*/; do
        n=${d%/}; n=${n##*/}
        valid_name "$n" && printf '%s\n' "$n"
    done
}
projects_by_use() {
    local n
    projects | while IFS= read -r n; do printf '%s\t%s\n' "$(proj_last_used "$n")" "$n"; done |
        sort -rn | cut -f2
}
rel_time() {
    local s=$(( $(date +%s) - $1 ))
    if   [ $s -lt 120 ];    then echo "gerade eben"
    elif [ $s -lt 3600 ];   then echo "vor $((s / 60)) Min"
    elif [ $s -lt 86400 ];  then echo "vor $((s / 3600)) Std"
    elif [ $s -lt 172800 ]; then echo "gestern"
    elif [ $s -lt 604800 ]; then echo "vor $((s / 86400)) Tagen"
    else date -d "@$1" '+%d.%m.%Y'
    fi
}
human() { numfmt --to=iec-i --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0} B"; }
i3msg() {   # i3 steuern, wenn vorhanden – sonst still nichts tun
    [ -n "${DISPLAY:-}" ] && command -v i3-msg >/dev/null 2>&1 && i3-msg -q "$@" >/dev/null 2>&1
    return 0
}
use_uv() { [ "$KI_USE_UV" != 0 ] && command -v uv >/dev/null 2>&1; }

# ------------------------------------------------------------------ PyCharm-Fenster
# Jedes PyCharm-Fenster belegt einen "Platz" 1…KI_IDE_MAX mit eigener Sperre.
# Platz 1 nutzt die Einstellungen direkt; weitere Plätze bekommen beim Start eine Kopie davon.
ide_slot_busy() { [ -e "$KI_RUN/ide-$1.lock" ] && ! flock -n "$KI_RUN/ide-$1.lock" true 2>/dev/null; }
ide_list() {   # "platz projekt" je offenem Fenster
    local s
    for s in $(seq 1 "$KI_IDE_MAX"); do
        ide_slot_busy "$s" && printf '%s %s\n' "$s" "$(cat "$KI_RUN/ide-$s.project" 2>/dev/null || echo '?')"
    done
}
ide_projects() { ide_list | cut -d' ' -f2; }
ide_free_slot() {
    local s
    for s in $(seq 1 "$KI_IDE_MAX"); do ide_slot_busy "$s" || { echo "$s"; return 0; }; done
    return 1
}
pc_config_dir() { if [ "$1" = 1 ]; then echo "$KI_PC/config"; else echo "$KI_PC/fenster-$1/config"; fi; }

# ------------------------------------------------------------------ Jobs
job_dir() { printf '%s/.ki/jobs' "$(proj_dir "$1")"; }
job_alive() {   # $1 = PID aus der .pid-Datei; schützt vor wiederverwendeten PIDs
    [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null &&
        [[ $(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) == *" _job "* ]]
}
job_state() {   # $1 Projekt, $2 Job-ID → läuft | fertig | fehler (rc) | abgebrochen
    local d rc; d=$(job_dir "$1")
    if [ -f "$d/$2.pid" ] && job_alive "$(cat "$d/$2.pid" 2>/dev/null)"; then echo "läuft"
    elif [ -f "$d/$2.exit" ]; then
        rc=$(cat "$d/$2.exit")
        if [ "$rc" = 0 ]; then echo "fertig"; else echo "fehler ($rc)"; fi
    else echo "abgebrochen"
    fi
}
job_ids() {
    local f
    for f in "$(job_dir "$1")"/*.cmd; do f=${f##*/}; printf '%s\n' "${f%.cmd}"; done | sort -r
}
running_jobs() {
    local id
    job_ids "$1" | while IFS= read -r id; do
        [ "$(job_state "$1" "$id")" = "läuft" ] && printf '%s\n' "$id"
    done
}
project_busy() {   # läuft PyCharm oder ein Job in diesem Projekt?
    grep -qxF -- "$1" <<< "$(ide_projects)" && return 0
    [ -n "$(running_jobs "$1")" ]
}

# ------------------------------------------------------------------ Der Kerker
# Baut die bwrap-Argumente in das Array KERKER.
# $1 Projekt, $2 Modus: gui (PyCharm) oder shell (Terminal, Jobs, Jupyter), $3 PyCharm-Platz
# Reihenfolge zählt: spätere Mounts überdecken frühere am selben Pfad.
kerker_build() {
    local name=$1 mode=$2 slot=${3:-1} P H uid gid run c venv path prof d f line key val
    P=$(proj_dir "$name"); H=$HOME; uid=$(id -u); gid=$(id -g)
    c="$H/.system_cache"; venv="$H/code/.venv"
    # Laufzeitordner für dconf, Sockets, Jupyter; ohne Login-Sitzung (su, cron) fehlt er auf dem Host
    run="/run/user/$uid"
    [ -d "$run" ] || run="/tmp/run-$uid"

    KERKER=(--unshare-user --unshare-pid --die-with-parent
            --uid "$uid" --gid "$gid"
            --ro-bind / /
            --proc /proc
            --dev /dev)
    for d in /dev/dri /dev/nvidia*; do
        [ -e "$d" ] && KERKER+=(--dev-bind "$d" "$d")
    done
    KERKER+=(--tmpfs /tmp
             --perms 0700 --tmpfs "$run"
             --bind "$P" "$H"
             --chdir "$H/code")

    # Nach dem Home-Swap gezielt wieder einblenden – nur lesbar
    for f in .gitconfig .ssh/config .ssh/known_hosts; do
        [ -e "$H/$f" ] && KERKER+=(--ro-bind "$H/$f" "$H/$f")
    done
    [ -d "$KI_SHARED" ] && KERKER+=(--ro-bind "$KI_SHARED" "$H/shared_data")

    if [ -n "${DISPLAY:-}" ]; then
        [ -d /tmp/.X11-unix ] && KERKER+=(--bind /tmp/.X11-unix /tmp/.X11-unix)
        f=${XAUTHORITY:-$H/.Xauthority}
        [ -f "$f" ] && KERKER+=(--ro-bind "$f" "$H/.Xauthority" --setenv XAUTHORITY "$H/.Xauthority")
    fi
    if [ "$mode" = gui ]; then
        # Einstellungen, Plugins, Lizenz- und EULA-Status (B7) aus ~/.ki/pycharm
        f=$(pc_config_dir "$slot")
        mkdir -p "$f" "$KI_PC/data" "$KI_PC/java"
        KERKER+=(--bind "$f" "$H/.config/JetBrains"
                 --bind "$KI_PC/data" "$H/.local/share/JetBrains"
                 --bind "$KI_PC/java" "$H/.java")
    fi
    if [ -S "${SSH_AUTH_SOCK:-}" ]; then
        # Git per SSH ohne Schlüsseldatei im Kerker
        KERKER+=(--bind "$SSH_AUTH_SOCK" "$run/ssh-agent.sock" --setenv SSH_AUTH_SOCK "$run/ssh-agent.sock")
    else
        KERKER+=(--unsetenv SSH_AUTH_SOCK)
    fi

    path="$venv/bin:$H/.local/bin"
    for d in /opt/ki/*/bin /usr/local/cuda/bin; do [ -d "$d" ] && path="$path:$d"; done
    path="$path:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    KERKER+=(--unsetenv DBUS_SESSION_BUS_ADDRESS --unsetenv PYTHONPATH --unsetenv PYTHONHOME
             --setenv HOME "$H" --setenv KI_PROJECT "$name" --setenv KI_USE_UV "$KI_USE_UV"
             --setenv XDG_RUNTIME_DIR "$run" --setenv XDG_CACHE_HOME "$c"
             --setenv VIRTUAL_ENV "$venv" --setenv PATH "$path"
             --setenv PIP_CACHE_DIR "$c/pip" --setenv UV_CACHE_DIR "$c/uv")

    prof=$(proj_profile "$name")
    case $prof in
        ml)   KERKER+=(--setenv HF_HOME "$c/huggingface" --setenv TORCH_HOME "$c/torch"
                       --setenv TORCHINDUCTOR_CACHE_DIR "$c/torchinductor"
                       --setenv TRITON_CACHE_DIR "$c/triton" --setenv CUDA_CACHE_PATH "$c/nv"
                       --setenv PYTORCH_CUDA_ALLOC_CONF "expandable_segments:True") ;;
        node) KERKER+=(--setenv NPM_CONFIG_CACHE "$c/npm" --setenv NPM_CONFIG_PREFIX "$H/.local") ;;
    esac

    # Eigene Variablen pro Projekt: .ki/env mit Zeilen KEY=Wert
    f="$P/.ki/env"
    if [ -f "$f" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
            key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
            [[ $val =~ ^\"(.*)\"$ || $val =~ ^\'(.*)\'$ ]] && val=${BASH_REMATCH[1]}
            KERKER+=(--setenv "$key" "$val")
        done < "$f"
    fi
    KERKER+=("${KERKER_ENV[@]}")
}

# Startet einen Befehl im Kerker. $1 Projekt, $2 Modus, Rest: Befehl (gui: $3 = Platz)
kerker_run() {
    local name=$1 mode=$2 slot=1 rc; shift 2
    if [ "$mode" = gui ]; then
        slot=$1; shift
        kerker_build "$name" gui "$slot"
        bwrap "${KERKER[@]}" -- "$@"
        return
    fi
    kerker_build "$name" shell
    # Strg+C soll nur das Programm treffen. Bekäme bwrap das Signal, würde es sterben und
    # der Kerker per --die-with-parent sofort mit SIGKILL enden – ohne dass ein Training
    # seinen Checkpoint speichern kann. Darum ignorieren ki und bwrap SIGINT, und im Kerker
    # schaltet perl es für den eigentlichen Befehl wieder scharf.
    trap '' INT QUIT
    bwrap "${KERKER[@]}" -- perl -e '$SIG{INT} = $SIG{QUIT} = "DEFAULT"; exec {$ARGV[0]} @ARGV or die "ki: $ARGV[0]: $!\n"' -- "$@"
    rc=$?
    trap - INT QUIT
    return $rc
}

# Im Kerker: .venv anlegen oder nach einem Python-Update neu anlegen. Offline-fähig:
# python3 -m venv nutzt die mitgelieferten Wheels. Eine andere Python-Version (KI_PY) holt uv.
VENV_SCRIPT='
v="$HOME/code/.venv"
[ -e "$v/bin/python" ] && exit 0
if [ -L "$v/bin/python" ]; then
    echo "ki: .venv zeigt auf ein entferntes Python (Python-Update) und wird neu angelegt." >&2
    echo "ki: Pakete danach neu installieren, z. B.: uv pip install -r requirements.txt" >&2
    rm -rf "$v"
fi
if [ -n "$KI_PY" ]; then
    command -v uv >/dev/null 2>&1 || { echo "ki: Python $KI_PY braucht uv (ki setup install uv)." >&2; exit 1; }
    exec uv venv -q --seed --python "$KI_PY" "$v"
fi
exec python3 -m venv "$v"'

# Installiert Pakete im Kerker – mit uv (schnell, Hardlinks statt Doppelkopie) oder pip
PIP_SCRIPT='if [ "$KI_USE_UV" != 0 ] && command -v uv >/dev/null 2>&1; then exec uv pip install "$@"; else exec pip install "$@"; fi'

# Läuft im Kerker um PyCharm herum. Startet PyCharm sich selbst neu (Plugins, Updates),
# übergibt es an den "restarter" und beendet sich. Würde der Kerker jetzt enden, stürbe der
# Neustart mit (B8). Darum bleibt er offen, solange IDE oder Restarter noch laufen.
IDE_WRAPPER='
"$@"; rc=$?
sleep 2
while pgrep -x "java|pycharm|restarter" >/dev/null 2>&1; do sleep 2; done
exit $rc'

write_bashrc() {
    cat > "$1/.bashrc" <<'EOF'
# Von ki erzeugt und bei jedem Start erneuert – eigene Ergänzungen in ~/.bashrc.local
HISTFILE="$HOME/.bash_history"; HISTSIZE=5000; HISTCONTROL=ignoredups:erasedups
alias ls='ls --color=auto' ll='ls -alF' grep='grep --color=auto'
PS1='\[\e[38;5;173m\][${KI_PROJECT}]\[\e[0m\] \w \$ '
if [ -z "${KI_JOB:-}" ] && [ -z "${TERMINAL_EMULATOR:-}" ]; then
    printf '\e[2mKerker %s · %s · Code in ~/code · exit = zurück\e[0m\n' "$KI_PROJECT" "$(python -V 2>&1)"
    command -v uv >/dev/null 2>&1 && [ "${KI_USE_UV:-auto}" != 0 ] &&
        printf '\e[2mPakete schnell installieren: uv pip install <paket>\e[0m\n'
fi
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
EOF
}

# Ordner, .bashrc und .venv sicherstellen
prepare_project() {
    local name=$1 P rc
    P=$(proj_dir "$name")
    mkdir -p "$P/code" "$P/.system_cache" "$P/.ki/jobs" || return 1
    write_bashrc "$P"
    touch "$P/.ki/last-used"
    KERKER_ENV=(--setenv KI_PY "$(cat "$P/.ki/python" 2>/dev/null)")
    kerker_run "$name" shell /bin/sh -c "$VENV_SCRIPT"
    rc=$?
    KERKER_ENV=()
    return $rc
}
pip_install() {   # pip_install <projekt> <argumente…> – im Kerker
    local name=$1; shift
    kerker_run "$name" shell /bin/sh -c "$PIP_SCRIPT" ki-pip "$@"
}

pycharm_launcher() {
    if [ -x "$KI_PYCHARM/bin/pycharm" ]; then echo "$KI_PYCHARM/bin/pycharm"
    elif [ -x "$KI_PYCHARM/bin/pycharm.sh" ]; then echo "$KI_PYCHARM/bin/pycharm.sh"
    else
        warn "PyCharm nicht gefunden unter $KI_PYCHARM. Installieren: ki setup install pycharm"
        return 1
    fi
}
# Speicherobergrenze für PyCharm setzen, falls noch keine eigene existiert.
# Ändern: Menü → Einstellungen, ki pycharm speicher <MB> oder in PyCharm: Help → Change Memory Settings.
ensure_vmoptions() {
    local dd f
    dd=$(sed -n 's/.*"dataDirectoryName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$KI_PYCHARM/product-info.json" 2>/dev/null | head -n1)
    [ -n "$dd" ] || return 0
    f="$KI_PC/config/$dd/pycharm64.vmoptions"
    [ -f "$f" ] && return 0
    mkdir -p "${f%/*}"
    printf -- '-Xmx%s\n-XX:+UseStringDeduplication\n' "$KI_IDE_XMX" > "$f"
}

# ------------------------------------------------------------------ Vorlagen
# Eingebaut: features/basis/templates/<name>; eigene: ~/.ki/basis/vorlagen/<name> (gehen vor).
# Eine Vorlage ist ein Ordner, der nach code/ kopiert wird. Optional darin: Datei "profil"
# mit ml, py oder node (Umgebung im Kerker); ohne sie gilt der Name, sonst py.
template_dir() {
    local t=$1
    if [ -d "$KI_DIR/basis/vorlagen/$t" ]; then echo "$KI_DIR/basis/vorlagen/$t"
    elif [ "$t" != common ] && [ -d "$REPO/features/basis/templates/$t" ]; then echo "$REPO/features/basis/templates/$t"
    else return 1; fi
}
template_profile() {
    local d=$1 t=${1##*/}
    if [ -f "$d/profil" ]; then head -n1 "$d/profil"
    else case $t in ml|node) echo "$t" ;; *) echo py ;; esac; fi
}
cmd__vorlagen() {   # Name und Beschreibung aller Vorlagen
    local d t seen=" "
    for d in "$KI_DIR"/basis/vorlagen/*/ "$REPO"/features/basis/templates/*/; do
        d=${d%/}; t=${d##*/}
        [ "$t" = common ] && continue
        [[ $seen == *" $t "* ]] && continue
        seen+="$t "
        printf '%s\t%s\n' "$t" "$(sed -n '1s/^# *//p' "$d/README.md" 2>/dev/null | sed 's/@NAME@/Projekt/' || true)"
    done
}

# Neues Projekt mit Grundgerüst anlegen (ohne Code-Inhalt); gibt den Projektordner aus
new_skeleton() {   # new_skeleton <name> <profil> [python]
    local name=$1 P
    valid_name "$name" || die "Ungültiger Name '$name' (erlaubt: a-z A-Z 0-9 - _, max. 64 Zeichen)."
    case $2 in ml|py|node) ;; *) die "Profil '$2' unbekannt (ml, py, node)." ;; esac
    P=$(proj_dir "$name")
    [ -e "$P" ] && die "'$name' gibt es schon."
    mkdir -p "$P/code" "$P/.ki/jobs" "$P/.system_cache" || die "Kann $P nicht anlegen."
    echo "$2" > "$P/.ki/profile"
    [ -n "${3:-}" ] && echo "$3" > "$P/.ki/python"
    return 0
}
finish_new() {   # Python-Umgebung, ggf. Pakete, Hinweise
    local name=$1 torch=$2 next=$3 P
    P=$(proj_dir "$name")
    info "Lege Python-Umgebung an …"
    prepare_project "$name" || die "Python-Umgebung konnte nicht angelegt werden (Projektordner bleibt: $P)."
    if [ "$(proj_profile "$name")" = node ] && ! command -v node >/dev/null 2>&1; then
        warn "Node.js ist nicht installiert: ki setup install node"
    fi
    if [ "$torch" = 1 ] && [ -f "$P/code/requirements.txt" ]; then
        info "Installiere requirements.txt …"
        pip_install "$name" -r requirements.txt || warn "Installation fehlgeschlagen – später im Projekt-Terminal wiederholen."
    fi
    info "Projekt '$name' bereit ($(proj_profile "$name")): $P"
    case $next in
        open)  cmd_open "$name" ;;
        shell) cmd_shell "$name" ;;
    esac
}

# ------------------------------------------------------------------ Befehle
cmd_new() {
    local name="" vorlage="" py="" torch=0 next="" tdir prof P
    while [ $# -gt 0 ]; do
        case $1 in
            -v|--vorlage|-p|--profile) [ $# -ge 2 ] || die "$1 braucht einen Wert"; vorlage=$2; shift 2 ;;
            --python)  [ $# -ge 2 ] || die "$1 braucht einen Wert"; py=$2; shift 2 ;;
            --torch|--install) torch=1; shift ;;
            --open)    next=open; shift ;;
            --shell)   next=shell; shift ;;
            -*)        die "Unbekannte Option: $1" ;;
            *)         [ -z "$name" ] || die "Nur ein Projektname erlaubt."; name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "Aufruf: ki new <name> [--vorlage ml|py|node|eigene] [--torch] [--python 3.12] [--open|--shell]"
    tdir=$(template_dir "${vorlage:-py}") || die "Vorlage '${vorlage}' gibt es nicht (ki new --vorlagen zeigt alle)."
    prof=$(template_profile "$tdir")
    new_skeleton "$name" "$prof" "$py"
    P=$(proj_dir "$name")
    [ -f "$REPO/features/basis/templates/common/gitignore" ] && cp "$REPO/features/basis/templates/common/gitignore" "$P/code/.gitignore"
    cp -r "$tdir/." "$P/code/" && rm -f "$P/code/profil"
    sed -i "s/@NAME@/$name/g" "$P/code/README.md" "$P/code/package.json" 2>/dev/null
    if command -v git >/dev/null 2>&1; then
        git -C "$P/code" init -q -b main 2>/dev/null || git -C "$P/code" init -q
    fi
    finish_new "$name" "$torch" "$next"
}

cmd_clone() {   # ki clone <git-url> [name] [--install] [--open]
    local url="" name="" torch=0 next="" P prof
    while [ $# -gt 0 ]; do
        case $1 in
            --install|--torch) torch=1 ;;
            --open) next=open ;;
            --shell) next=shell ;;
            -*) die "Unbekannte Option: $1" ;;
            *) if [ -z "$url" ]; then url=$1; else name=$1; fi ;;
        esac
        shift
    done
    [ -n "$url" ] || die "Aufruf: ki clone <git-url> [name] [--install] [--open]"
    [ -n "$name" ] || { name=${url%/}; name=${name##*/}; name=${name%.git}; name=${name//[^A-Za-z0-9_-]/-}; }
    prof=py
    new_skeleton "$name" "$prof"
    P=$(proj_dir "$name")
    rmdir "$P/code"
    info "Klone $url …"
    if ! git clone "$url" "$P/code"; then rm -rf "$P"; die "git clone fehlgeschlagen (Adresse? Netz?)."; fi
    grep -qsiE '^(torch|tensorflow|jax|transformers)' "$P/code/requirements.txt" && echo ml > "$P/.ki/profile"
    [ -f "$P/code/package.json" ] && [ ! -f "$P/code/requirements.txt" ] && echo node > "$P/.ki/profile"
    finish_new "$name" "$torch" "$next"
}

cmd_import() {   # ki import <ordner> [name] – vorhandenen Code (z. B. vom USB-Stick) übernehmen
    local src=${1:-} name=${2:-} P
    [ -d "$src" ] || die "Aufruf: ki import <ordner> [name]"
    src=$(cd "$src" && pwd)
    [ -n "$name" ] || { name=${src##*/}; name=${name//[^A-Za-z0-9_-]/-}; }
    new_skeleton "$name" py
    P=$(proj_dir "$name")
    info "Kopiere $src → $P/code (ohne .venv, .idea, __pycache__) …"
    rsync -a --exclude .venv --exclude venv --exclude .idea --exclude __pycache__ "$src/" "$P/code/" ||
        { rm -rf "$P"; die "Kopieren fehlgeschlagen."; }
    grep -qsiE '^(torch|tensorflow|jax|transformers)' "$P/code/requirements.txt" && echo ml > "$P/.ki/profile"
    finish_new "$name" 0 ""
    [ -f "$P/code/requirements.txt" ] && say_hint "Pakete installieren: ki shell $name -- uv pip install -r requirements.txt"
    return 0
}

cmd_open() {
    local name=${1:-} slot
    need_project "$name"
    has pycharm || die "PyCharm ist nicht installiert: ki setup install pycharm"
    [ -n "${DISPLAY:-}" ] || die "PyCharm braucht die Oberfläche. Per SSH/Konsole: ki shell, ki run, ki jupyter."
    if grep -qxF -- "$name" <<< "$(ide_projects)"; then
        i3msg workspace "$KI_WS_IDE"
        info "'$name' ist schon in PyCharm offen (Arbeitsfläche IDE)."
        return 0
    fi
    slot=$(ide_free_slot) || die "Schon $KI_IDE_MAX PyCharm-Fenster offen – erst eines schließen."
    pycharm_launcher >/dev/null || exit 1
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    ensure_vmoptions
    if [ "${KI_FOREGROUND:-0}" = 1 ]; then cmd__ide "$name" "$slot"; fi
    setsid -f "$SELF" _ide "$name" "$slot" </dev/null >/dev/null 2>&1
    info "PyCharm startet mit '$name' auf der Arbeitsfläche IDE (zurück zum Menü: Win+1)."
    if [ "$slot" -gt 1 ]; then
        say_hint "Zusätzliches Fenster: braucht weitere 1,5–2 GB RAM. Es startet mit einer Kopie deiner"
        say_hint "Einstellungen – Änderungen daran bitte im ersten Fenster machen."
        say_hint "Nebeneinander: Win+E · als Reiter: Win+W · auf den zweiten Monitor: Win+Shift+O"
    fi
}

# Intern: hält die Sperre des Platzes, startet PyCharm im Kerker und holt danach das Menü zurück
cmd__ide() {
    local name=$1 slot=${2:-1} P launcher rc cfg
    P=$(proj_dir "$name")
    mkdir -p "$KI_RUN"
    exec 9>"$KI_RUN/ide-$slot.lock"
    flock -n 9 || die "PyCharm-Platz $slot ist belegt."
    printf '%s\n' "$name" > "$KI_RUN/ide-$slot.project"
    launcher=$(pycharm_launcher) || exit 1
    if [ "$slot" -gt 1 ]; then
        # Kopie der Einstellungen von Fenster 1 – ohne Sperr- und Portdateien
        cfg=$(pc_config_dir "$slot")
        mkdir -p "$cfg"
        rsync -a --delete --exclude '.lock' --exclude '*.lock' --exclude '.port' --exclude 'port*' \
            "$KI_PC/config/" "$cfg/" 2>/dev/null
    fi
    # Projektname im Fenstertitel (sonst hieße jedes Projekt "code")
    if [ -d "$P/code/.idea" ] && [ "$(cat "$P/code/.idea/.name" 2>/dev/null)" != "$name" ]; then
        printf '%s' "$name" > "$P/code/.idea/.name"
    fi
    i3msg workspace "$KI_WS_IDE"
    printf '# PyCharm-Start %s · Projekt %s · Fenster %s\n' "$(date '+%F %T')" "$name" "$slot" > "$P/.ki/ide.log"
    kerker_run "$name" gui "$slot" /bin/sh -c "$IDE_WRAPPER" ki-ide "$launcher" "$HOME/code" >>"$P/.ki/ide.log" 2>&1
    rc=$?
    printf '# Ende %s · Exit-Code %s\n' "$(date '+%F %T')" "$rc" >> "$P/.ki/ide.log"
    rm -f "$KI_RUN/ide-$slot.project"
    grep -qv "^$slot " <<< "$(ide_list)" || i3msg workspace "$KI_WS_MENU"   # letztes Fenster zu → Menü
    exit "$rc"
}

cmd_shell() {
    local name=${1:-}
    need_project "$name"; shift
    [ "${1:-}" = -- ] && shift
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    [ $# -gt 0 ] || set -- bash
    kerker_run "$name" shell "$@"
}

cmd_run() {
    local name=${1:-} id dir label
    need_project "$name"; shift
    case ${1:-} in
        --sh) [ -n "${2:-}" ] || die "--sh braucht eine Befehlszeile"; label=$2; set -- bash -c "$2" ;;
        --)   shift; label="$*" ;;
        *)    label="$*" ;;
    esac
    [ $# -gt 0 ] || die "Aufruf: ki run <projekt> -- <befehl …>   oder   ki run <projekt> --sh \"befehlszeile\""
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    dir=$(job_dir "$name")
    id=$(date +%Y%m%d-%H%M%S)
    [ -e "$dir/$id.cmd" ] && { sleep 1; id=$(date +%Y%m%d-%H%M%S); }
    printf '%s\n' "$label" > "$dir/$id.cmd"
    setsid -f "$SELF" _job "$name" "$id" "$@" </dev/null >"$dir/$id.log" 2>&1
    info "Job $id läuft im Hintergrund (auch nach dem Abmelden)."
    say_hint "Log:   ki logs $name"
    say_hint "Stopp: ki stop $name $id"
}

# Intern: läuft als eigene Sitzung (setsid), PID = Prozessgruppe des Jobs
cmd__job() {
    local name=$1 id=$2 dir rc; shift 2
    dir=$(job_dir "$name")
    echo $$ > "$dir/$id.pid"
    trap 'echo "# SIGTERM erhalten"' TERM
    printf '# ki-Job %s · Projekt %s · Start %s\n# Befehl: %s\n\n' "$id" "$name" "$(date '+%F %T')" "$(cat "$dir/$id.cmd")"
    KERKER_ENV=(--setenv PYTHONUNBUFFERED 1 --setenv KI_JOB "$id")
    kerker_run "$name" shell "$@"
    rc=$?
    echo "$rc" > "$dir/$id.exit"
    rm -f "$dir/$id.pid"
    printf '\n# Ende %s · Exit-Code %s\n' "$(date '+%F %T')" "$rc"
    exit "$rc"
}

cmd_jobs() {
    local porcelain=0 n id st list
    [ "${1:-}" = --porcelain ] && { porcelain=1; shift; }
    if [ -n "${1:-}" ]; then need_project "$1"; list=$1; else list=$(projects); fi
    for n in $list; do
        for id in $(job_ids "$n" | head -n 10); do
            st=$(job_state "$n" "$id")
            if [ $porcelain = 1 ]; then
                printf '%s\t%s\t%s\t%s\n' "$n" "$id" "$st" "$(head -c 200 "$(job_dir "$n")/$id.cmd")"
            else
                case $st in läuft) st="${C_OK}$st${C_0}" ;; fertig) ;; *) st="${C_ERR}$st${C_0}" ;; esac
                printf '%-20s %-16s %-40s %s\n' "$n" "$id" "$(head -c 40 "$(job_dir "$n")/$id.cmd")" "$st"
            fi
        done
    done
}

cmd_logs() {
    local name=${1:-} id=${2:-} f
    need_project "$name"
    [ -n "$id" ] || id=$(job_ids "$name" | head -n1)
    [ -n "$id" ] || die "Keine Jobs in '$name'."
    f="$(job_dir "$name")/$id.log"
    [ -f "$f" ] || die "Kein Log für Job $id."
    if [ ! -t 1 ]; then cat "$f"
    elif [ "$(job_state "$name" "$id")" = "läuft" ]; then less -R +F "$f"   # Strg+C stoppt Mitlaufen, q beendet
    else less -R +G "$f"
    fi
}

cmd_stop() {
    local name=${1:-} id=${2:-} pid
    need_project "$name"
    if [ -z "$id" ]; then
        id=$(running_jobs "$name")
        [ -n "$id" ] || { info "In '$name' läuft kein Job."; return 0; }
        [ "$(printf '%s\n' "$id" | wc -l)" -eq 1 ] || die "Mehrere Jobs laufen – ID angeben: $(echo "$id" | tr '\n' ' ')"
    fi
    pid=$(cat "$(job_dir "$name")/$id.pid" 2>/dev/null)
    job_alive "$pid" || { info "Job $id läuft nicht."; return 0; }
    # Wie Strg+C: das Programm darf aufräumen (Checkpoint speichern)
    info "Stoppe Job $id – das Programm bekommt Strg+C und darf aufräumen …"
    kill -INT -- "-$pid" 2>/dev/null
    for _ in $(seq 30); do job_alive "$pid" || { info "Job $id beendet."; return 0; }; sleep 1; done
    warn "Keine Reaktion nach 30 s – beende hart."
    kill -TERM -- "-$pid" 2>/dev/null; sleep 3
    job_alive "$pid" && kill -KILL -- "-$pid" 2>/dev/null
    info "Job $id beendet."
}

cmd_jupyter() {
    local name=${1:-} port=${2:-$KI_JUPYTER_PORT} ip
    need_project "$name"
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    if [ ! -x "$(proj_dir "$name")/code/.venv/bin/jupyter" ]; then
        info "JupyterLab fehlt im Projekt – wird installiert (einmalig, braucht Internet) …"
        pip_install "$name" jupyterlab || die "Installation fehlgeschlagen."
    fi
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    printf '%s\n' "${C_B}JupyterLab für '$name'${C_0} – lauscht nur lokal (Port $port), Zugriff per SSH-Tunnel:" \
        "  Auf dem Zweitrechner (braucht die Funktion fernzugriff): ssh -N -L $port:127.0.0.1:$port $(id -un)@${ip:-<IP>}" \
        "  Dann dort im Browser die Adresse http://127.0.0.1:$port/lab?token=… aus der Ausgabe unten öffnen." \
        "  Beenden: Strg+C" ""
    kerker_run "$name" shell jupyter lab --no-browser --ip=127.0.0.1 --port="$port" \
        --ServerApp.root_dir="$HOME/code"
}

cmd_list() {
    local porcelain=0 size=0 n prof last st sz ides
    while [ $# -gt 0 ]; do
        case $1 in --porcelain) porcelain=1 ;; --size) size=1 ;; *) die "Unbekannte Option: $1" ;; esac
        shift
    done
    ides=$(ide_projects)
    projects_by_use | while IFS= read -r n; do
        prof=$(proj_profile "$n"); last=$(proj_last_used "$n"); st=""; sz=""
        grep -qxF -- "$n" <<< "$ides" && st="PyCharm"
        [ -n "$(running_jobs "$n")" ] && st="${st:+$st, }Job"
        [ $size = 1 ] && sz=$(du -sh "$(proj_dir "$n")" 2>/dev/null | cut -f1)
        if [ $porcelain = 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$prof" "$last" "$st" "$sz"
        else
            printf '%-22s %-5s %-14s %6s  %s\n' "$n" "$prof" "$(rel_time "$last")" "$sz" "${st:+${C_ACC}$st${C_0}}"
        fi
    done
}

cmd_caches() {
    local name=${1:-} d
    need_project "$name"
    for d in "$(proj_dir "$name")/.system_cache"/*/; do
        printf '%s\t%s\n' "$(basename "$d")" "$(du -sh "$d" 2>/dev/null | cut -f1)"
    done
}
clean_project() {
    local name=$1 c before after d dirs=() x; shift
    c="$(proj_dir "$name")/.system_cache"
    [ -d "$c" ] || return 0
    if project_busy "$name"; then warn "'$name' wird gerade benutzt – Cache bleibt."; return 1; fi
    if [ $# -gt 0 ]; then for x in "$@"; do dirs+=("$c/$x/"); done; else dirs=("$c"/*/); fi
    before=$(du -sb "$c" 2>/dev/null | cut -f1)
    for d in "${dirs[@]}"; do
        [ -d "$d" ] || continue
        chmod -R u+w "$d" 2>/dev/null
        find "$d" -mindepth 1 -delete 2>/dev/null
    done
    after=$(du -sb "$c" 2>/dev/null | cut -f1)
    info "$name: $(human $(( ${before:-0} - ${after:-0} ))) freigegeben"
}
cmd_clean() {
    local n
    if [ "${1:-}" = --all ]; then
        for n in $(projects); do clean_project "$n"; done
        return 0
    fi
    need_project "${1:-}"
    n=$1; shift
    clean_project "$n" "$@"
}

cmd_rm() {
    local name=${1:-} answer
    need_project "$name"
    project_busy "$name" && die "'$name' wird gerade benutzt (PyCharm oder Job)."
    if [ "${2:-}" != --yes ]; then
        [ -t 0 ] || die "Löschen ohne Rückfrage nur mit --yes."
        printf 'Projekt %s mit Code, .venv, Caches und Modellen endgültig löschen?\nZum Bestätigen den Namen eingeben: ' "$name"
        read -r answer
        [ "$answer" = "$name" ] || die "Abgebrochen."
    fi
    rm -rf -- "$(proj_dir "$name")" || die "Löschen fehlgeschlagen."
    info "Projekt '$name' gelöscht."
}

cmd_mv() {
    local old=${1:-} new=${2:-}
    need_project "$old"
    valid_name "$new" || die "Ungültiger neuer Name '$new'."
    [ -e "$(proj_dir "$new")" ] && die "'$new' gibt es schon."
    project_busy "$old" && die "'$old' wird gerade benutzt."
    # Im Kerker ist jedes Projekt ~ – Umbenennen bricht keine Pfade
    mv -- "$(proj_dir "$old")" "$(proj_dir "$new")" && info "'$old' heißt jetzt '$new'."
}

power_mode() {
    local g
    g=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) || { echo "unbekannt"; return; }
    if [ "$g" = performance ]; then echo "Leistung"; else echo "ausgewogen"; fi
}
cmd_power() {
    local m
    case ${1:-status} in
        status) power_mode; return ;;
        performance|leistung) m=performance ;;
        balanced|ausgewogen)  m=balanced ;;
        *) die "Aufruf: ki power [performance|balanced]" ;;
    esac
    has menue || die "Der CPU-Schalter gehört zur Funktion menue: ki setup install menue"
    sudo -n /opt/ki/menue/ki-power "$m" >/dev/null || die "ki-power ließ sich nicht ausführen."
    info "CPU-Modus: $(power_mode)"
}

gpu_line() {
    command -v nvidia-smi >/dev/null 2>&1 || return 1
    nvidia-smi --query-gpu=memory.used,memory.total,temperature.gpu,utilization.gpu,power.draw \
        --format=csv,noheader,nounits 2>/dev/null |
        awk -F', *' 'NR==1 {printf "%.1f / %.1f GiB VRAM · %s °C · %s %% Last · %s W\n", $1/1024, $2/1024, $3, $4, $5}'
}
cmd_status() {
    local n id g s p
    printf '%sRAM%s    ' "$C_B" "$C_0"
    free -m | awk '/^Mem:/ {printf "%.1f / %.1f GiB belegt, %.1f GiB verfügbar\n", $3/1024, $2/1024, $7/1024}'
    printf '%sSwap%s   ' "$C_B" "$C_0"
    swapon --show=NAME,SIZE,USED --noheadings 2>/dev/null | awk '{printf "%s %s (%s belegt)  ", $1, $2, $3} END {if (NR==0) printf "keiner"; print ""}'
    if g=$(gpu_line); then printf '%sGPU%s    %s\n' "$C_B" "$C_0" "$g"; fi
    printf '%sSSD%s    ' "$C_B" "$C_0"; df -h --output=avail,size / | awk 'NR==2 {print $1 " frei von " $2}'
    printf '%sCPU%s    Modus %s · Last %s\n' "$C_B" "$C_0" "$(power_mode)" "$(cut -d' ' -f1-3 /proc/loadavg)"
    while read -r s p; do printf '%sIDE%s    Fenster %s: %s\n' "$C_B" "$C_0" "$s" "$p"; done < <(ide_list)
    for n in $(projects); do
        for id in $(running_jobs "$n"); do
            printf '%sJob%s    %s %s: %s\n' "$C_B" "$C_0" "$n" "$id" "$(head -c 60 "$(job_dir "$n")/$id.cmd")"
        done
    done
}

cmd_doctor() {
    local n_err=0 n_warn=0 v f out lst e known
    ok()   { printf '  %s✔%s %s\n' "$C_OK" "$C_0" "$*"; }
    bad()  { printf '  %s✘%s %s\n' "$C_ERR" "$C_0" "$1"; [ -n "${2:-}" ] && say_hint "  → $2"; n_err=$((n_err + 1)); }
    hint() { printf '  %s!%s %s\n' "$C_ACC" "$C_0" "$1"; [ -n "${2:-}" ] && say_hint "  → $2"; n_warn=$((n_warn + 1)); }
    sect() { printf '\n%s%s%s\n' "$C_B" "$*" "$C_0"; }

    sect "System"
    # shellcheck source=/dev/null
    v=$( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")
    ok "$v · Kernel $(uname -r)"
    lst=""; for f in "$REPO"/features/*/; do f=${f%/}; f=${f##*/}; has "$f" && lst+="$f "; done
    ok "Funktionen: ${lst:-keine}"
    for f in "$KI_DIR"/*/.manifest; do
        f=${f%/.manifest}; f=${f##*/}
        has "$f" || bad "Funktion $f ist nur halb installiert" "ki setup install $f  oder  ki setup remove $f"
    done

    sect "Kerker"
    if ! command -v bwrap >/dev/null 2>&1; then bad "bubblewrap fehlt" "ki setup install basis"
    elif out=$(bwrap --unshare-user --uid "$(id -u)" --gid "$(id -g)" --ro-bind / / true 2>&1); then ok "bwrap mit User-Namespace"
    else bad "bwrap scheitert: $out" "ki setup reinstall basis (AppArmor-Freigabe)"; fi
    if use_uv; then ok "uv $(uv --version 2>/dev/null | cut -d' ' -f2)"
    elif ! has uv; then hint "uv nicht installiert – Installationen langsamer, Pakete doppelt (pip-Cache + .venv)" "ki setup install uv"; fi

    if has nvidia; then
        sect "GPU"
        if ! out=$(nvidia-smi --query-gpu=name,driver_version,persistence_mode,display_active,memory.used \
                   --format=csv,noheader,nounits 2>&1); then
            bad "Treiber antwortet nicht: $out" "Neustart; nach Kernel-Update: dkms status; sonst ki setup reinstall nvidia"
        else
            IFS=',' read -r v f _ _ _ <<< "$out"; ok "$v · Treiber${f}"
            if [[ $(cut -d, -f3 <<< "$out") == *Enabled* ]]; then ok "Persistence Mode an"
            else hint "Persistence Mode aus" "sudo systemctl start ki-gpu"; fi
            if [[ $(cut -d, -f4 <<< "$out") == *Enabled* ]]; then
                hint "Bildschirm hängt an der RTX – Xorg belegt VRAM ($(cut -d, -f5 <<< "$out" | tr -d ' ') MiB belegt)" \
                     "Monitor ans Mainboard + ki setup install igpu"
            else ok "RTX frei von Grafikausgabe – volles VRAM für CUDA"; fi
        fi
    fi

    if has pycharm; then
        sect "PyCharm"
        if pycharm_launcher >/dev/null 2>&1; then
            v=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$KI_PYCHARM/product-info.json" 2>/dev/null | head -n1)
            ok "PyCharm ${v:-?} ($(readlink -f "$KI_PYCHARM"))"
        else bad "PyCharm fehlt unter $KI_PYCHARM" "ki pycharm update"; fi
        ok "Einstellungen: $KI_PC ($(du -sh "$KI_PC" 2>/dev/null | cut -f1))"
    fi

    if has oberflaeche && [ -n "${DISPLAY:-}" ]; then
        sect "Oberfläche"
        if grep -qi 'background:.*#2B2B2B' <<< "$(xrdb -query 2>/dev/null)"; then ok "Farbschema geladen"
        else hint "Farbschema nicht geladen" "Win+Shift+R oder neu anmelden"; fi
        if grep -q '"instance":"ki-menu"' <<< "$(i3-msg -t get_tree 2>/dev/null)"; then ok "Menü-Fenster vorhanden"
        else hint "Menü-Fenster nicht gefunden" "Win+Shift+R"; fi
    fi

    sect "Speicher"
    ok "$(free -m | awk '/^Mem:/ {printf "RAM %.1f GiB, davon %.1f GiB verfügbar", $2/1024, $7/1024}')"
    if has speicher; then
        lst=$(swapon --show=NAME --noheadings 2>/dev/null)
        if grep -q zram <<< "$lst"; then ok "zram-Swap aktiv"; else hint "zram nicht aktiv" "ki setup reinstall speicher"; fi
        if systemctl is-active --quiet earlyoom 2>/dev/null; then ok "earlyoom aktiv"
        else hint "earlyoom läuft nicht" "sudo systemctl enable --now earlyoom"; fi
    fi
    v=$(df --output=avail -BG / | tail -n1 | tr -dc '0-9')
    if [ "${v:-0}" -lt 30 ]; then bad "nur ${v} GiB frei auf /" "ki clean --all oder alte Projekte löschen"; else ok "${v} GiB frei auf /"; fi

    sect "Ordnung im Home (Dateileichen)"
    known=" projects shared_data .ki .profile .bashrc .bash_logout .bash_history .cache .local .hushlogin .sudo_as_admin_successful .ssh .gitconfig .python_history .selected_editor .lesshst .wget-hsts .viminfo "
    out=""
    for e in "$HOME"/* "$HOME"/.[!.]*; do
        e=${e##*/}
        [[ $known == *" $e "* ]] || out+="$e "
    done
    if [ -n "$out" ]; then hint "Nicht vom System angelegt: $out" "deine eigenen Dateien – oder ein Programm schreibt am Kerker vorbei"
    else ok "keine fremden Einträge im Home"; fi
    for e in "$HOME"/.local/share/* "$HOME"/.config/*; do
        case $e in */.local/share/xorg) continue ;; esac
        hint "Programmdaten außerhalb von ~/.ki: ${e#"$HOME"/}" "Herkunft prüfen; ggf. löschen"
    done
    v=$(du -sm "$HOME/.cache" 2>/dev/null | cut -f1)
    if [ "${v:-0}" -gt 100 ]; then hint "Host-Cache ~/.cache ist ${v} MiB groß" "du -sh ~/.cache/* | sort -h"
    else ok "Host-Cache klein (${v:-0} MiB)"; fi

    sect "Netz (nur für Installationen nötig)"
    v=$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 https://pypi.org/simple/ 2>/dev/null)
    case $v in 2*|3*) ok "Internet erreichbar" ;; *) ok "offline – Arbeiten geht trotzdem; Installationen brauchen Netz" ;; esac

    printf '\n'
    if [ $n_err -eq 0 ] && [ $n_warn -eq 0 ]; then info "Alles in Ordnung."
    else info "$n_err Fehler, $n_warn Hinweise."; fi
    [ $n_err -eq 0 ]
}

# Für das Menü: Zustand in einem Aufruf
cmd__state() {
    local n last="" jobs=0 f feats=""
    for n in $(projects_by_use); do
        [ -n "$last" ] || last=$n
        jobs=$((jobs + $(running_jobs "$n" | grep -c .)))
    done
    for f in "$REPO"/features/*/; do f=${f%/}; f=${f##*/}; has "$f" && feats+="$f "; done
    printf 'ide=%s\nlast=%s\njobs=%s\npower=%s\nfeatures=%s\nprojects=%s\nws_menu=%s\nws_ide=%s\nws_extra=%s\nrepo=%s\n' \
        "$(ide_projects | paste -sd, -)" "$last" "$jobs" "$(power_mode)" "$feats" "$KI_PROJECTS" \
        "$KI_WS_MENU" "$KI_WS_IDE" "$KI_WS_EXTRA" "$REPO"
}
cmd__lastcmd() {
    local id; id=$(job_ids "$1" | head -n1)
    [ -n "$id" ] && cat "$(job_dir "$1")/$id.cmd"
}

feature_cmd() {   # gibt den Pfad eines Funktions-Befehls aus, wenn die Funktion installiert ist
    local f
    for f in "$REPO"/features/*/bin/ki-"$1"; do
        has "$(basename "$(dirname "$(dirname "$f")")")" && { echo "$f"; return 0; }
    done
    return 1
}
cmd__commands() {
    local f
    echo "new clone import open shell run jobs logs stop jupyter list clean rm mv status doctor power setup update help"
    for f in "$REPO"/features/*/bin/ki-*; do
        has "$(basename "$(dirname "$(dirname "$f")")")" && basename "$f" | sed 's/^ki-//'
    done
}

cmd_help() {
    cat <<EOF
${C_B}ki $KI_VERSION – der eine Befehl der KI-Workstation${C_0}

${C_B}Projekte${C_0}
  ki new <name> [--vorlage ml|py|node|eigene] [--torch] [--python 3.12] [--open|--shell]
  ki clone <git-url> [name] [--install]   Git-Repo als Projekt (requirements.txt wird erkannt)
  ki import <ordner> [name]               vorhandenen Code übernehmen, z. B. vom USB-Stick
  ki open <name>              PyCharm im Kerker; ein zweites Projekt öffnet ein zweites Fenster
  ki shell <name> [befehl…]   Terminal/Befehl im Kerker, ohne IDE (spart 1,5–2 GB RAM)
  ki list [--size]   ki clean <name> [ordner…] | --all   ki mv <alt> <neu>   ki rm <name>
  Eigene Vorlagen: Ordner nach ~/.ki/basis/vorlagen/<name>/ legen (optional Datei "profil": ml|py|node)

${C_B}Training & KI${C_0}
  ki run <name> -- python train.py      Job im Hintergrund (läuft weiter, auch ohne Menü)
  ki run <name> --sh "befehlszeile"     dito als Shell-Befehlszeile
  ki jobs [name]   ki logs <name> [id]   ki stop <name> [id]   (Stopp = Strg+C, dann hart)
  ki jupyter <name> [port]              JupyterLab (Browser hier oder per SSH-Tunnel)
  ki power [performance|balanced]       CPU-Leistungsmodus

${C_B}Funktionen & System${C_0}
  ki setup                    Funktionen wählen (installieren/entfernen)
  ki setup list | files <f> | remove <f> | update
  ki status   ki doctor (auch Dateileichen-Suche)
EOF
    has menue && echo "  ki menu                     Menü (startet in der Oberfläche automatisch)"
    has oberflaeche && echo "  ki start                    Oberfläche von der Konsole starten"
    has dateien && echo "  ki dateien [ordner]   ki usb   Dateimanager, USB-Sticks"
    has monitor && echo "  ki top [cpu]                GPU-/CPU-Monitor"
    has pycharm && echo "  ki pycharm update|versionen|aufraeumen|speicher <MB>"
    cat <<EOF

${C_B}Tasten${C_0} (Win = Super-Taste – Alt bleibt für PyCharm frei)
  Win+1 Menü · Win+2 IDE · Win+3 Extra · Win+Tab zurück · Win+Enter Terminal · Win+D Dateien
  Win+G GPU-Monitor · Win+Shift+Q Fenster schließen · Win+F Vollbild · Win+Shift+R i3 neu laden
  Zwei Projekte: Win+E nebeneinander/untereinander · Win+W Reiter · Win+R Größe (Pfeile, Enter)
  Zweiter Monitor: Win+O Arbeitsfläche hinüber · Win+Shift+O Fenster hinüber
  Terminal: Strg+Bild↑/↓ Schriftgröße · Strg+Shift+C/V kopieren/einfügen

${C_B}Ordner${C_0}
  ~/projects/<name>/code   dein Code (im Kerker ~/code)    ~/shared_data   Datensätze, Modelle (nur lesen)
  ~/.ki/<funktion>/        alles, was eine Funktion ablegt   $REPO   das Setup (Git)
EOF
}

# ------------------------------------------------------------------ Verteiler
if [ -n "${KI_PROJECT:-}" ] && [ "${1:-}" != help ]; then
    die "ki läuft nur auf dem Host, nicht im Kerker (hier: Projekt $KI_PROJECT)."
fi
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
    "")              if [ -t 0 ] && [ -t 1 ] && f=$(feature_cmd menu); then exec "$f"; fi
                     cmd_help ;;
    new)             if [ "${1:-}" = --vorlagen ]; then cmd__vorlagen; else cmd_new "$@"; fi ;;
    clone)           cmd_clone "$@" ;;
    import)          cmd_import "$@" ;;
    open)            cmd_open "$@" ;;
    shell|sh)        cmd_shell "$@" ;;
    run)             cmd_run "$@" ;;
    jobs)            cmd_jobs "$@" ;;
    logs|log)        cmd_logs "$@" ;;
    stop)            cmd_stop "$@" ;;
    jupyter)         cmd_jupyter "$@" ;;
    list|ls)         cmd_list "$@" ;;
    caches)          cmd_caches "$@" ;;
    clean)           cmd_clean "$@" ;;
    rm)              cmd_rm "$@" ;;
    mv|rename)       cmd_mv "$@" ;;
    status)          cmd_status "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    power)           cmd_power "$@" ;;
    setup)           exec "$REPO/setup" "$@" ;;
    update)          exec "$REPO/setup" update "$@" ;;
    version|--version) echo "ki $KI_VERSION" ;;
    help|-h|--help)  cmd_help ;;
    _ide)            cmd__ide "$@" ;;
    _job)            cmd__job "$@" ;;
    _state)          cmd__state ;;
    _lastcmd)        cmd__lastcmd "$@" ;;
    _projects)       projects ;;
    _commands)       cmd__commands ;;
    *)               if f=$(feature_cmd "$cmd"); then exec "$f" "$@"; fi
                     if [ -n "$(ls "$REPO"/features/*/bin/ki-"$cmd" 2>/dev/null)" ]; then
                         die "'ki $cmd' gehört zu einer Funktion, die nicht installiert ist (ki setup)."
                     fi
                     die "Unbekannter Befehl '$cmd' – Übersicht: ki help" ;;
esac
