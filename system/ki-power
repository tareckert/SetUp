#!/bin/sh
# /usr/local/sbin/ki-power – CPU-Leistungsmodus umschalten (per sudo ohne Passwort freigegeben)
#   performance: volle Taktrate, kürzeste Reaktionszeit (lange Trainings)
#   balanced:    Standard, taktet bei Last trotzdem voll hoch
set -eu
mode=${1:-status}
cpu0=/sys/devices/system/cpu/cpu0/cpufreq
driver=$(cat "$cpu0/scaling_driver" 2>/dev/null || echo none)
available=$(cat "$cpu0/scaling_available_governors" 2>/dev/null || echo "")

case $mode in
    performance) gov=performance; epp=performance ;;
    balanced)
        if [ "$driver" = intel_pstate ]; then gov=powersave; epp=balance_performance
        elif echo "$available" | grep -qw schedutil; then gov=schedutil; epp=""
        else gov=ondemand; epp=""; fi ;;
    status) cat "$cpu0/scaling_governor"; exit 0 ;;
    *) echo "Aufruf: ki-power performance|balanced|status" >&2; exit 2 ;;
esac

for c in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
    echo "$gov" > "$c/scaling_governor" 2>/dev/null || true
    if [ -n "$epp" ] && [ -w "$c/energy_performance_preference" ]; then
        echo "$epp" > "$c/energy_performance_preference" 2>/dev/null || true
    fi
done
cat "$cpu0/scaling_governor"
