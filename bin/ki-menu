#!/usr/bin/env bash
# ki-menu – Hauptmenü der KI-Workstation (Vollbild-Terminal auf Arbeitsfläche 1)
#
# Reine Oberfläche: jede Aktion erledigt das CLI "ki", das genauso per SSH funktioniert.
# Bedienung: Pfeiltasten + Enter, Esc = zurück (im Hauptmenü: Anzeige auffrischen).
# Ohne gum läuft ein schlichter Notfallmodus mit nummerierten Einträgen.
set -uo pipefail

KI="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/ki"
[ -x "$KI" ] || KI=ki

# Darcula-Farben wie Terminal und i3
ACC="#CC7832" FG="#A9B7C6" DIM="#808080" BG="#2B2B2B" ERR="#F2777A"
export GUM_CHOOSE_CURSOR_FOREGROUND=$ACC GUM_CHOOSE_HEADER_FOREGROUND=$DIM GUM_CHOOSE_ITEM_FOREGROUND=$FG \
       GUM_CHOOSE_SELECTED_FOREGROUND=$ACC \
       GUM_FILTER_INDICATOR_FOREGROUND=$ACC GUM_FILTER_MATCH_FOREGROUND=$ACC GUM_FILTER_PROMPT_FOREGROUND=$ACC \
       GUM_FILTER_HEADER_FOREGROUND=$DIM GUM_FILTER_TEXT_FOREGROUND=$FG GUM_FILTER_CURSOR_TEXT_FOREGROUND=$ACC \
       GUM_INPUT_CURSOR_FOREGROUND=$ACC GUM_INPUT_PROMPT_FOREGROUND=$ACC GUM_INPUT_HEADER_FOREGROUND=$DIM \
       GUM_CONFIRM_PROMPT_FOREGROUND=$FG GUM_CONFIRM_SELECTED_BACKGROUND=$ACC GUM_CONFIRM_SELECTED_FOREGROUND=$BG \
       GUM_CONFIRM_UNSELECTED_BACKGROUND="#3C3F41" GUM_CONFIRM_UNSELECTED_FOREGROUND=$FG \
       GUM_FILE_CURSOR_FOREGROUND=$ACC GUM_FILE_HEADER_FOREGROUND=$DIM

HAVE_GUM=0
command -v gum >/dev/null 2>&1 && HAVE_GUM=1
trap ':' INT                       # Strg+C beendet das laufende Programm, nie das Menü
printf '\e]2;KI-Menü\a'

# ------------------------------------------------------------------ Bausteine
INDENT="  "
set_indent() {   # Einrückung, damit die Liste unter dem Kopf mittig steht
    local w=0 x pad cols
    for x in "$@"; do [ "${#x}" -gt "$w" ] && w=${#x}; done
    cols=$(tput cols 2>/dev/null || echo 80)
    pad=$(( (cols - w - 2) / 2 ))
    [ $pad -lt 2 ] && pad=2
    printf -v INDENT '%*s' "$pad" ''
}
clear_screen() { printf '\e[H\e[2J\e[3J'; }   # inkl. Scrollback
# Bildschirmausgaben gehen nach stderr: stdout gehört den Rückgabewerten (p=$(pick_project …))
pause() { printf '\n%s' "${INDENT}Weiter mit beliebiger Taste …" >&2; read -r -s -n 1 _ </dev/tty; }
say_err() {
    if [ $HAVE_GUM = 1 ]; then gum style --foreground "$ERR" "$INDENT$*" >&2
    else printf '%s! %s\n' "$INDENT" "$*" >&2; fi
}

ui_choose() {   # $1 Überschrift, Rest: Einträge → gewählter Eintrag
    local header=$1 i n; shift
    set_indent "$header" "$@"
    if [ $HAVE_GUM = 1 ]; then
        gum choose --cursor "$INDENT› " --header "${header:+$INDENT$header}" --height "$(( $# + 1 ))" -- "$@"
        return
    fi
    [ -n "$header" ] && printf '\n%s%s\n' "$INDENT" "$header" >&2
    i=1; for n in "$@"; do printf '%s%2d) %s\n' "$INDENT" "$i" "$n" >&2; i=$((i + 1)); done
    read -r -p "${INDENT}Nummer (Enter = zurück): " n </dev/tty || return 1
    [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le $# ] || return 1
    printf '%s\n' "${!n}"
}
ui_multi() {   # $1 Überschrift, Rest: Einträge → gewählte Einträge (zeilenweise)
    local header=$1; shift
    set_indent "$header" "$@"
    if [ $HAVE_GUM = 1 ]; then
        gum choose --no-limit --cursor "$INDENT› " --header "$INDENT$header" --height "$(( $# + 1 ))" -- "$@"
    else
        printf '%s\n' "$@"
    fi
}
ui_input() {   # $1 Überschrift, $2 Platzhalter, $3 Vorgabe → Eingabe
    local v
    if [ $HAVE_GUM = 1 ]; then
        gum input --header "$INDENT$1" --placeholder "$2" --value "${3:-}" --prompt "$INDENT› " --char-limit 300
        return
    fi
    read -r -e -p "$INDENT$1: " -i "${3:-}" v </dev/tty || return 1
    printf '%s\n' "$v"
}
ui_confirm() {   # $1 Frage, $2 = no → Vorauswahl "Nein"
    local a
    if [ $HAVE_GUM = 1 ]; then
        if [ "${2:-}" = no ]; then gum confirm "$INDENT$1" --affirmative "Ja" --negative "Nein" --default=false
        else gum confirm "$INDENT$1" --affirmative "Ja" --negative "Nein"; fi
        return
    fi
    read -r -p "$INDENT$1 [j/N] " a </dev/tty || return 1
    [[ $a =~ ^[jJyY] ]]
}
ui_pager() { if [ $HAVE_GUM = 1 ]; then gum pager; else less -R; fi; }

i3ws() { [ -n "${DISPLAY:-}" ] && i3-msg -q workspace number "$1" >/dev/null 2>&1; return 0; }

# ------------------------------------------------------------------ Zustand & Kopf
S_IDE="" S_LAST="" S_JOBS=0 S_OLD=0 S_POWER="" S_IDE_WS=2 S_EXTRA_WS=3 S_PROJECTS="$HOME/projects"
load_state() {
    local k v
    while IFS='=' read -r k v; do
        case $k in
            ide) S_IDE=$v ;; last) S_LAST=$v ;; jobs) S_JOBS=$v ;; old) S_OLD=$v ;; power) S_POWER=$v ;;
            ide_ws) S_IDE_WS=$v ;; extra_ws) S_EXTRA_WS=$v ;; projects) S_PROJECTS=$v ;;
        esac
    done < <("$KI" _state 2>/dev/null)
}

draw_header() {
    local l1 l2 l3="" ram gpu disk age cols w ml x
    load_state
    ram=$(free -m | awk '/^Mem:/ {printf "RAM %.1f/%.0f G", $3/1024, $2/1024}')
    gpu=$(nvidia-smi --query-gpu=memory.used,memory.total,temperature.gpu --format=csv,noheader,nounits 2>/dev/null |
          awk -F', *' 'NR==1 {printf "GPU %.1f/%.0f G %s°C", $1/1024, $2/1024, $3}')
    disk=$(df -h --output=avail / 2>/dev/null | awk 'NR==2 {print "SSD " $1 " frei"}')
    l1="KI-Workstation · $(hostname -s) · $(date '+%a %d.%m. %H:%M')"
    l2="$ram   ${gpu:+$gpu   }$disk"
    [ -n "$S_IDE" ] && l3+="PyCharm: $S_IDE   "
    [ "${S_JOBS:-0}" -gt 0 ] && l3+="Jobs aktiv: $S_JOBS   "
    [ "$S_POWER" = Leistung ] && l3+="CPU: Leistung   "
    [ -e /var/run/reboot-required ] && l3+="Neustart nötig   "
    if [ -f /var/cache/apt/pkgcache.bin ]; then
        age=$(( ($(date +%s) - $(stat -c %Y /var/cache/apt/pkgcache.bin)) / 86400 ))
        [ $age -ge 14 ] && l3+="Update fällig ($age Tage)   "
    fi
    [ -z "$S_LAST" ] && [ "${S_OLD:-0}" = 0 ] && l3+="Los geht's: Neues Projekt anlegen"
    [ "${S_OLD:-0}" -gt 0 ] && l3+="$S_OLD Projekt(e) im alten Layout → Projekte verwalten"
    l3=${l3%   }

    clear_screen
    cols=$(tput cols 2>/dev/null || echo 80)
    w=0; for x in "$l1" "$l2" "$l3"; do [ "${#x}" -gt "$w" ] && w=${#x}; done
    ml=$(( (cols - w - 8) / 2 )); [ $ml -lt 0 ] && ml=0
    if [ $HAVE_GUM = 1 ]; then
        if [ -n "$l3" ]; then
            gum style --border rounded --border-foreground "$ACC" --foreground "$FG" --align center \
                --padding "0 3" --margin "1 $ml" "$l1" "$l2" "$l3"
        else
            gum style --border rounded --border-foreground "$ACC" --foreground "$FG" --align center \
                --padding "0 3" --margin "1 $ml" "$l1" "$l2"
        fi
    else
        printf '\n%*s%s\n%*s%s\n' "$ml" '' "$l1" "$ml" '' "$l2"
        [ -n "$l3" ] && printf '%*s%s\n' "$ml" '' "$l3"
        printf '\n'
    fi
}

# ------------------------------------------------------------------ Projekte wählen
# Zeilen aus "ki list --porcelain": name, profil, zuletzt, status, größe
pick_project() {   # $1 Überschrift, $2 = size → mit Größen → Projektname
    local header=$1 rows=() args=(--porcelain) name prof last st sz line choice n=0 profs
    if [ "${2:-}" = size ]; then args+=(--size); printf '%sBerechne Größen …\n' "$INDENT" >&2; fi
    while IFS=$'\t' read -r name prof last st sz; do
        case $prof in ml) profs="KI/ML" ;; node) profs="Node" ;; *) profs="Python" ;; esac
        printf -v line '%-24s %-7s %-13s %6s  %s' "$name" "$profs" "$(rel "$last")" "$sz" "$st"
        rows+=("${line%"${line##*[! ]}"}")
        n=$((n + 1))
    done < <("$KI" list "${args[@]}" 2>/dev/null)
    if [ $n = 0 ]; then
        say_err "Noch keine Projekte – im Hauptmenü \"Neues Projekt\" wählen."
        pause; return 1
    fi
    if [ $HAVE_GUM = 1 ] && [ $n -gt 12 ]; then
        set_indent "${rows[@]}"
        choice=$(printf '%s\n' "${rows[@]}" | gum filter --header "$header" --placeholder "Tippen zum Filtern …" \
                 --prompt "› " --height 20) || return 1
    else
        choice=$(ui_choose "$header" "${rows[@]}") || return 1
    fi
    printf '%s\n' "${choice%% *}"
}
rel() {
    local s=$(( $(date +%s) - $1 ))
    if   [ $s -lt 120 ];    then echo "gerade eben"
    elif [ $s -lt 3600 ];   then echo "vor $((s / 60)) Min"
    elif [ $s -lt 86400 ];  then echo "vor $((s / 3600)) Std"
    elif [ $s -lt 172800 ]; then echo "gestern"
    elif [ $s -lt 604800 ]; then echo "vor $((s / 86400)) Tg"
    else date -d "@$1" '+%d.%m.%Y'
    fi
}
is_old() { "$KI" list --porcelain 2>/dev/null | awk -F'\t' -v p="$1" '$1 == p && $4 ~ /altes Layout/ {f=1} END {exit !f}'; }
ensure_layout() {   # altes Layout? → anbieten umzustellen
    is_old "$1" || return 0
    ui_confirm "'$1' hat noch das alte Layout (v1). Jetzt umstellen? Code wandert nach code/." || return 1
    clear_screen; "$KI" migrate "$1"; pause
    ! is_old "$1"
}

# ------------------------------------------------------------------ Aktionen
run_open() {
    local out
    ensure_layout "$1" || return
    if ! out=$("$KI" open "$1" 2>&1); then
        clear_screen; printf '%s\n' "$out"; pause
    fi
}
run_shell() {
    ensure_layout "$1" || return
    clear_screen
    "$KI" shell "$1"
}

new_project() {
    local name prof torch=() next
    while :; do
        name=$(ui_input "Name des neuen Projekts" "z. B. bilderkennung  (a-z A-Z 0-9 - _)") || return
        [ -n "$name" ] || return
        [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] && break
        say_err "Erlaubt sind a-z A-Z 0-9 - _ (nicht am Anfang), max. 64 Zeichen."
    done
    prof=$(ui_choose "Profil für $name" "KI/ML – PyTorch, GPU, Hugging Face" "Python – schlank" "Node/JS") || return
    case $prof in KI*) prof=ml ;; Node*) prof=node ;; *) prof=py ;; esac
    if [ $prof = ml ] && ui_confirm "PyTorch gleich installieren? (einmalig ca. 3 GB Download)"; then torch=(--torch); fi
    clear_screen
    if ! "$KI" new "$name" --profile "$prof" "${torch[@]}"; then pause; return; fi
    next=$(ui_choose "Projekt $name ist bereit – wie weiter?" "In PyCharm öffnen" "Terminal im Projekt" "Zurück zum Menü") || return
    case $next in
        "In PyCharm"*) run_open "$name" ;;
        Terminal*)     run_shell "$name" ;;
    esac
}

start_job() {
    local p last cmd c
    p=$(pick_project "Job starten in …") || return
    ensure_layout "$p" || return
    last=$("$KI" _lastcmd "$p" 2>/dev/null)
    cmd=$(ui_input "Befehl im Kerker (Arbeitsordner ~/code) – läuft im Hintergrund weiter" "python train.py" "${last:-python train.py}") || return
    [ -n "$cmd" ] || return
    clear_screen
    "$KI" run "$p" --sh "$cmd" || { pause; return; }
    c=$(ui_choose "Job gestartet" "Log live ansehen (Strg+C stoppt Mitlaufen, q beendet)" "Zurück") || return
    [[ $c == Log* ]] && "$KI" logs "$p"
}

show_jobs() {
    local rows=() p id st cmd line c
    while IFS=$'\t' read -r p id st cmd; do
        printf -v line '%-16s %-20s %-12s %s' "$id" "$p" "$st" "${cmd:0:50}"
        rows+=("$line")
    done < <("$KI" jobs --porcelain 2>/dev/null | sort -t$'\t' -k2,2r)
    if [ ${#rows[@]} = 0 ]; then say_err "Noch keine Jobs."; pause; return; fi
    c=$(ui_choose "Jobs (neueste zuerst)" "${rows[@]}") || return
    read -r id p st _ <<< "$c"
    if [ "$st" = "läuft" ]; then
        c=$(ui_choose "Job $id in $p" "Log live ansehen" "Stoppen (Strg+C an das Programm, Checkpoint möglich)" "Zurück") || return
    else
        c=$(ui_choose "Job $id in $p ($st)" "Log ansehen" "Zurück") || return
    fi
    case $c in
        Log*)    "$KI" logs "$p" "$id" ;;
        Stopp*)  clear_screen; "$KI" stop "$p" "$id"; pause ;;
    esac
}

start_jupyter() {
    local p
    p=$(pick_project "JupyterLab starten für …") || return
    ensure_layout "$p" || return
    if [ -n "${DISPLAY:-}" ] && command -v urxvt >/dev/null 2>&1; then
        # Eigenes Fenster auf der Extra-Arbeitsfläche, das Menü bleibt frei
        urxvt -name ki-extra -title "Jupyter $p" -e sh -c \
            '"$0" jupyter "$1"; printf "\nEnter = Fenster schließen"; read -r _' "$KI" "$p" >/dev/null 2>&1 &
        i3ws "$S_EXTRA_WS"
    else
        clear_screen; "$KI" jupyter "$p"; pause
    fi
}

clean_dialog() {   # $1 Projekt
    local rows=() name sz sel names=()
    while IFS=$'\t' read -r name sz; do rows+=("$(printf '%-16s %s' "$name" "$sz")"); done < <("$KI" caches "$1")
    if [ ${#rows[@]} = 0 ]; then say_err "Keine Caches in $1."; pause; return; fi
    sel=$(ui_multi "Welche Caches leeren? Leertaste = auswählen, Enter = los" "${rows[@]}") || return
    [ -n "$sel" ] || return
    while read -r name _; do names+=("$name"); done <<< "$sel"
    clear_screen; "$KI" clean "$1" "${names[@]}"; pause
}

browse_files() {
    local f c root=$S_PROJECTS
    if [ $HAVE_GUM = 0 ]; then say_err "Dateibrowser braucht gum."; pause; return; fi
    f=$(gum file --file --height 20 --header "Datei wählen (Esc = zurück)" "$root") || return
    [ -f "$f" ] || return
    c=$(ui_choose "${f#"$root"/}" "Anzeigen" "Löschen" "Zurück") || return
    case $c in
        Anzeigen) less -R "$f" ;;
        Löschen)  ui_confirm "Datei ${f##*/} wirklich löschen?" no && rm -f -- "$f" ;;
    esac
}

project_actions() {   # $1 Projekt
    local p=$1 c new
    while :; do
        c=$(ui_choose "Projekt $p" "In PyCharm öffnen" "Terminal im Projekt" "Job-Logs" "PyCharm-Log" \
            "Cache leeren …" "Umbenennen" "Löschen" "Zurück") || return
        case $c in
            "In PyCharm"*) run_open "$p"; return ;;
            Terminal*)     run_shell "$p" ;;
            Job-Logs)      "$KI" logs "$p" 2>/dev/null || { say_err "Noch keine Jobs."; pause; } ;;
            PyCharm-Log)   less -R +G "$S_PROJECTS/$p/.ki/ide.log" 2>/dev/null ||
                               { say_err "Noch kein PyCharm-Log."; pause; } ;;
            Cache*)        clean_dialog "$p" ;;
            Umbenennen)    new=$(ui_input "Neuer Name für $p" "a-z A-Z 0-9 - _" "$p") || continue
                           if [ -z "$new" ] || [ "$new" = "$p" ]; then continue; fi
                           if "$KI" mv "$p" "$new"; then p=$new; else pause; fi ;;
            Löschen)       ui_confirm "Projekt $p mit Code, .venv, Caches und Modellen endgültig löschen?" no || continue
                           clear_screen; "$KI" rm "$p" --yes; pause; return ;;
            *)             return ;;
        esac
    done
}

# ------------------------------------------------------------------ Untermenüs
jobs_menu() {
    local c
    while :; do
        draw_header
        c=$(ui_choose "Training & Jobs" "Job starten" "Jobs ansehen" "JupyterLab für den Zweitrechner" \
            "GPU-Monitor (q = zurück)" "CPU-Modus: $S_POWER → umschalten" "Zurück") || return
        case $c in
            "Job starten")  start_job ;;
            "Jobs ansehen") show_jobs ;;
            Jupyter*)       start_jupyter ;;
            GPU*)           "$KI" top ;;
            CPU*)           clear_screen
                            if [ "$S_POWER" = Leistung ]; then "$KI" power balanced; else "$KI" power performance; fi ||
                                pause ;;
            *)              return ;;
        esac
    done
}

manage_menu() {
    local c items p
    while :; do
        draw_header
        items=("Projekt auswählen (mit Größe)" "Alle Caches leeren" "Dateien durchsuchen")
        [ "${S_OLD:-0}" -gt 0 ] && items+=("Altes Layout umstellen ($S_OLD Projekte)")
        items+=("Zurück")
        c=$(ui_choose "Projekte verwalten" "${items[@]}") || return
        case $c in
            Projekt*)  p=$(pick_project "Projekt" size) && project_actions "$p" ;;
            "Alle C"*) ui_confirm "Caches aller Projekte leeren? (pip, uv, Hugging Face, PyCharm-Index …)" no &&
                           { clear_screen; "$KI" clean --all; pause; } ;;
            Dateien*)  browse_files ;;
            Altes*)    clear_screen; "$KI" migrate --all; pause ;;
            *)         return ;;
        esac
    done
}

system_update() {
    clear_screen
    printf '%sSystem aktualisieren (sudo-Passwort nötig)\n\n' "$INDENT"
    sudo apt update && sudo apt full-upgrade
    printf '\n'
    if command -v nvidia-smi >/dev/null 2>&1 && ! nvidia-smi -L >/dev/null 2>&1; then
        say_err "nvidia-smi antwortet nicht – nach dem Neustart erneut prüfen (Treiber wird per DKMS gebaut)."
    fi
    [ -e /var/run/reboot-required ] && say_err "Neustart nötig, damit Kernel/Treiber aktiv werden."
    pause
}

system_menu() {
    local c
    while :; do
        draw_header
        c=$(ui_choose "System" "Status" "Diagnose (ki doctor)" "System aktualisieren (apt)" \
            "Setup aktualisieren (Repo + install.sh)" "PyCharm aktualisieren" "Host-Terminal (sudo, apt)" \
            "Neu starten" "Zurück") || return
        case $c in
            Status)       clear_screen; "$KI" status; pause ;;
            Diagnose*)    clear_screen; "$KI" doctor; pause ;;
            "System a"*)  system_update ;;
            "Setup a"*)   clear_screen; "$KI" update; pause ;;
            PyCharm*)     clear_screen; "$KI" pycharm-update; pause ;;
            Host*)        clear_screen
                          printf 'Host-Shell – hier wirken sudo und apt. exit = zurück zum Menü\n\n'
                          bash -i ;;
            "Neu starten") ui_confirm "Rechner neu starten?" no && { sudo -n systemctl reboot 2>/dev/null || systemctl reboot; } ;;
            *)            return ;;
        esac
    done
}

power_off() {
    local warn=""
    [ -n "$S_IDE" ] && warn="PyCharm ist noch offen. "
    [ "${S_JOBS:-0}" -gt 0 ] && warn+="$S_JOBS Job(s) laufen noch. "
    ui_confirm "${warn}Rechner ausschalten?" no || return
    sudo -n systemctl poweroff 2>/dev/null || systemctl poweroff
}

# ------------------------------------------------------------------ Hauptschleife
main_menu() {
    local items c p
    while :; do
        draw_header
        items=()
        if [ -n "$S_IDE" ]; then items+=("▶ Zu PyCharm ($S_IDE)")
        elif [ -n "$S_LAST" ]; then items+=("▶ Weiter mit $S_LAST")
        fi
        items+=("Projekt öffnen" "Neues Projekt" "Terminal im Projekt" "Training & Jobs" \
                "Projekte verwalten" "System" "Hilfe & Tasten" "Ausschalten")
        c=$(ui_choose "" "${items[@]}") || continue
        case $c in
            "▶ Zu PyCharm"*)  i3ws "$S_IDE_WS" ;;
            "▶ Weiter mit"*)  run_open "$S_LAST" ;;
            "Projekt öffnen") p=$(pick_project "In PyCharm öffnen") && run_open "$p" ;;
            "Neues Projekt")  new_project ;;
            Terminal*)        p=$(pick_project "Terminal im Kerker – ohne IDE, spart 1,5–2 GB RAM") && run_shell "$p" ;;
            Training*)        jobs_menu ;;
            "Projekte v"*)    manage_menu ;;
            System)           system_menu ;;
            Hilfe*)           "$KI" help | ui_pager ;;
            Ausschalten)      power_off ;;
        esac
    done
}

main_menu
