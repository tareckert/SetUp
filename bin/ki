#!/usr/bin/env bash
# ki – Projektwerkzeug der KI-Workstation (Kommandozeile; das Menü ki-menu baut darauf auf)
#
# Jedes Projekt ist ein Ordner unter ~/projects/<name>/. Für PyCharm, Terminal und Jobs
# blendet bubblewrap ("Kerker") ihn als Home-Verzeichnis ein:
#
#   ~/projects/<name>/             → ~             Caches, Dotfiles, .ki/ (Profil, Logs, Jobs)
#   ~/projects/<name>/code/        → ~/code        dein Code = PyCharm-Projektwurzel
#   ~/projects/<name>/code/.venv/  → ~/code/.venv  Interpreter-Pfad ist in jedem Projekt gleich
#
# Alles, was pip, PyCharm oder ein Training schreibt, landet im Projektordner oder im RAM.
# Bewusst ohne "set -e": Fehler werden gezielt behandelt, damit nie ein halber Zustand
# zurückbleibt (Lehre aus B1/B13).
set -uo pipefail
shopt -s nullglob

KI_VERSION="2.0"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
SELF_DIR=${SELF%/*}

# ------------------------------------------------------------------ Einstellungen
# Alle Werte lassen sich in ~/.config/ki/ki.conf überschreiben (Vorlage: ki.conf.example).
KI_PROJECTS="$HOME/projects"
KI_SHARED="$HOME/shared_data"
KI_PYCHARM="/opt/pycharm"
KI_IDE_XMX="2048m"
KI_IDE_WS=2
KI_MENU_WS=1
KI_EXTRA_WS=3
KI_JUPYTER_PORT=8888
KI_USE_UV=auto
KI_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ki"
# shellcheck source=/dev/null
[ -f "$KI_CONFIG_DIR/ki.conf" ] && . "$KI_CONFIG_DIR/ki.conf"

KI_RUN="${XDG_RUNTIME_DIR:-/tmp/ki-$(id -u)}/ki"
KI_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ki"
KI_TEMPLATES="${XDG_DATA_HOME:-$HOME/.local/share}/ki/templates"
[ -d "$KI_TEMPLATES" ] || KI_TEMPLATES="$SELF_DIR/../templates"
KERKER=()
KERKER_ENV=()

if [ -t 1 ]; then
    C_ACC=$'\e[38;5;173m' C_OK=$'\e[38;5;107m' C_ERR=$'\e[38;5;210m' C_DIM=$'\e[2m' C_B=$'\e[1m' C_0=$'\e[0m'
else
    C_ACC='' C_OK='' C_ERR='' C_DIM='' C_B='' C_0=''
fi
info() { printf '%s›%s %s\n' "$C_ACC" "$C_0" "$*"; }
warn() { printf '%s!%s %s\n' "$C_ACC" "$C_0" "$*" >&2; }
die()  { printf '%s✘%s %s\n' "$C_ERR" "$C_0" "$*" >&2; exit 1; }

# ------------------------------------------------------------------ Hilfsfunktionen
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]]; }
proj_dir()   { printf '%s/%s' "$KI_PROJECTS" "$1"; }

need_project() {
    [ -n "${1:-}" ] || die "Projektname fehlt."
    valid_name "$1" || die "Ungültiger Projektname '$1' (erlaubt: a-z A-Z 0-9 - _)."
    [ -d "$(proj_dir "$1")" ] || die "Projekt '$1' gibt es nicht (anlegen: ki new $1)."
}
is_old_layout() { [ ! -d "$(proj_dir "$1")/code" ]; }
need_new_layout() {
    is_old_layout "$1" && die "'$1' hat noch das alte Layout (Code direkt im Projektordner). Einmalig umstellen: ki migrate $1"
    return 0
}

proj_profile() {
    local f; f="$(proj_dir "$1")/.ki/profile"
    if [ -f "$f" ]; then head -n1 "$f"; else echo py; fi
}
proj_last_used() {
    local P; P=$(proj_dir "$1")
    stat -c %Y "$P/.ki/last-used" 2>/dev/null || stat -c %Y "$P"
}
projects() {   # alle Projektnamen
    local d n
    for d in "$KI_PROJECTS"/*/; do
        n=${d%/}; n=${n##*/}
        valid_name "$n" && printf '%s\n' "$n"
    done
}
projects_by_use() {   # Projektnamen, zuletzt benutzte zuerst
    local n
    projects | while IFS= read -r n; do printf '%s\t%s\n' "$(proj_last_used "$n")" "$n"; done |
        sort -rn | cut -f2
}

rel_time() {
    local s=$(( $(date +%s) - $1 ))
    if   [ $s -lt 120 ];    then echo "gerade eben"
    elif [ $s -lt 3600 ];   then echo "vor $((s / 60)) Min"
    elif [ $s -lt 86400 ];  then echo "vor $((s / 3600)) Std"
    elif [ $s -lt 172800 ]; then echo "gestern"
    elif [ $s -lt 604800 ]; then echo "vor $((s / 86400)) Tagen"
    else date -d "@$1" '+%d.%m.%Y'
    fi
}
human() { numfmt --to=iec-i --suffix=B "${1:-0}" 2>/dev/null || echo "${1:-0} B"; }

i3msg() {   # i3 steuern, wenn vorhanden – sonst still nichts tun
    [ -n "${DISPLAY:-}" ] && command -v i3-msg >/dev/null 2>&1 && i3-msg -q "$@" >/dev/null 2>&1
    return 0
}

use_uv() { [ "$KI_USE_UV" != 0 ] && command -v uv >/dev/null 2>&1; }

# ------------------------------------------------------------------ PyCharm-Status
ide_project() {   # gibt das Projekt aus, das gerade in PyCharm offen ist
    [ -e "$KI_RUN/ide.lock" ] || return 1
    flock -n "$KI_RUN/ide.lock" true 2>/dev/null && return 1
    cat "$KI_RUN/ide.project" 2>/dev/null || echo "?"
}

# ------------------------------------------------------------------ Jobs
job_dir() { printf '%s/.ki/jobs' "$(proj_dir "$1")"; }
job_alive() {   # $1 = PID aus der .pid-Datei; schützt vor wiederverwendeten PIDs
    [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null &&
        tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q ' _job '
}
job_state() {   # $1 Projekt, $2 Job-ID → läuft | fertig | fehler (rc) | abgebrochen
    local d rc; d=$(job_dir "$1")
    if [ -f "$d/$2.pid" ] && job_alive "$(cat "$d/$2.pid" 2>/dev/null)"; then echo "läuft"
    elif [ -f "$d/$2.exit" ]; then
        rc=$(cat "$d/$2.exit")
        if [ "$rc" = 0 ]; then echo "fertig"; else echo "fehler ($rc)"; fi
    else echo "abgebrochen"
    fi
}
job_ids() {   # Job-IDs eines Projekts, neueste zuerst
    local f
    for f in "$(job_dir "$1")"/*.cmd; do f=${f##*/}; printf '%s\n' "${f%.cmd}"; done | sort -r
}
running_jobs() {
    local id
    job_ids "$1" | while IFS= read -r id; do
        [ "$(job_state "$1" "$id")" = "läuft" ] && printf '%s\n' "$id"
    done
}
project_busy() {   # läuft PyCharm oder ein Job in diesem Projekt?
    [ "$(ide_project 2>/dev/null)" = "$1" ] && return 0
    [ -n "$(running_jobs "$1")" ]
}

# ------------------------------------------------------------------ Der Kerker
# Baut die bwrap-Argumente in das Array KERKER.
# $1 = Projekt, $2 = Modus: gui (PyCharm) oder shell (Terminal, Jobs, Jupyter)
# Reihenfolge zählt: spätere Mounts überdecken frühere am selben Pfad.
kerker_build() {
    local name=$1 mode=$2 P H uid gid run c venv path prof d f line key val
    P=$(proj_dir "$name"); H=$HOME; uid=$(id -u); gid=$(id -g)
    c="$H/.system_cache"; venv="$H/code/.venv"
    # Laufzeitordner für dconf, Sockets, Jupyter; ohne Login-Sitzung (su, cron) fehlt er auf dem Host
    run="/run/user/$uid"
    [ -d "$run" ] || run="/tmp/run-$uid"

    KERKER=(--unshare-user --unshare-pid --die-with-parent
            --uid "$uid" --gid "$gid"
            --ro-bind / /
            --proc /proc
            --dev /dev)
    for d in /dev/dri /dev/nvidia*; do
        [ -e "$d" ] && KERKER+=(--dev-bind "$d" "$d")
    done
    KERKER+=(--tmpfs /tmp
             --perms 0700 --tmpfs "$run"
             --bind "$P" "$H"
             --chdir "$H/code")

    # Nach dem Home-Swap gezielt wieder einblenden – nur lesbar
    for f in .gitconfig .ssh/config .ssh/known_hosts; do
        [ -e "$H/$f" ] && KERKER+=(--ro-bind "$H/$f" "$H/$f")
    done
    [ -d "$KI_SHARED" ] && KERKER+=(--ro-bind "$KI_SHARED" "$H/shared_data")

    if [ -n "${DISPLAY:-}" ]; then
        [ -d /tmp/.X11-unix ] && KERKER+=(--bind /tmp/.X11-unix /tmp/.X11-unix)
        f=${XAUTHORITY:-$H/.Xauthority}
        [ -f "$f" ] && KERKER+=(--ro-bind "$f" "$H/.Xauthority" --setenv XAUTHORITY "$H/.Xauthority")
    fi
    if [ "$mode" = gui ]; then
        # Globale IDE-Einstellungen, Plugins, Lizenz- und EULA-Status (B7)
        for d in .config/JetBrains .local/share/JetBrains .java; do
            mkdir -p "$H/$d"
            KERKER+=(--bind "$H/$d" "$H/$d")
        done
    fi
    if [ -S "${SSH_AUTH_SOCK:-}" ]; then
        # Git per SSH ohne Schlüsseldatei im Kerker
        KERKER+=(--bind "$SSH_AUTH_SOCK" "$run/ssh-agent.sock" --setenv SSH_AUTH_SOCK "$run/ssh-agent.sock")
    else
        KERKER+=(--unsetenv SSH_AUTH_SOCK)
    fi

    path="$venv/bin:$H/.local/bin"
    [ -d /usr/local/cuda/bin ] && path="$path:/usr/local/cuda/bin"
    path="$path:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    KERKER+=(--unsetenv DBUS_SESSION_BUS_ADDRESS --unsetenv PYTHONPATH --unsetenv PYTHONHOME
             --setenv HOME "$H" --setenv KI_PROJECT "$name" --setenv KI_USE_UV "$KI_USE_UV"
             --setenv XDG_RUNTIME_DIR "$run" --setenv XDG_CACHE_HOME "$c"
             --setenv VIRTUAL_ENV "$venv" --setenv PATH "$path"
             --setenv PIP_CACHE_DIR "$c/pip" --setenv UV_CACHE_DIR "$c/uv")

    prof=$(proj_profile "$name")
    case $prof in
        ml)   KERKER+=(--setenv HF_HOME "$c/huggingface" --setenv TORCH_HOME "$c/torch"
                       --setenv TORCHINDUCTOR_CACHE_DIR "$c/torchinductor"
                       --setenv TRITON_CACHE_DIR "$c/triton" --setenv CUDA_CACHE_PATH "$c/nv"
                       --setenv PYTORCH_CUDA_ALLOC_CONF "expandable_segments:True") ;;
        node) KERKER+=(--setenv NPM_CONFIG_CACHE "$c/npm" --setenv NPM_CONFIG_PREFIX "$H/.local") ;;
    esac

    # Eigene Variablen pro Projekt: .ki/env mit Zeilen KEY=Wert
    f="$P/.ki/env"
    if [ -f "$f" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
            key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
            [[ $val =~ ^\"(.*)\"$ || $val =~ ^\'(.*)\'$ ]] && val=${BASH_REMATCH[1]}
            KERKER+=(--setenv "$key" "$val")
        done < "$f"
    fi
    KERKER+=("${KERKER_ENV[@]}")
}

# Startet einen Befehl im Kerker. $1 Projekt, $2 Modus, Rest: Befehl
kerker_run() {
    local name=$1 mode=$2 rc; shift 2
    kerker_build "$name" "$mode"
    if [ "$mode" = gui ]; then
        bwrap "${KERKER[@]}" -- "$@"
        return
    fi
    # Strg+C soll nur das Programm treffen. Bekäme bwrap das Signal, würde es sterben und
    # der Kerker per --die-with-parent sofort mit SIGKILL enden – ohne dass ein Training
    # seinen Checkpoint speichern kann. Darum ignorieren ki und bwrap SIGINT, und im Kerker
    # schaltet perl es für den eigentlichen Befehl wieder scharf.
    trap '' INT QUIT
    bwrap "${KERKER[@]}" -- perl -e '$SIG{INT} = $SIG{QUIT} = "DEFAULT"; exec {$ARGV[0]} @ARGV or die "ki: $ARGV[0]: $!\n"' -- "$@"
    rc=$?
    trap - INT QUIT
    return $rc
}

# Wird im Kerker ausgeführt: legt .venv an oder repariert es nach einem Python-Update.
VENV_SCRIPT='
v="$HOME/code/.venv"
[ -e "$v/bin/python" ] && exit 0
if [ -L "$v/bin/python" ]; then
    echo "ki: .venv zeigt auf ein entferntes Python (Python-Update) und wird neu angelegt." >&2
    echo "ki: Pakete danach neu installieren, z. B.: uv pip install -r requirements.txt" >&2
    rm -rf "$v"
fi
if [ "$KI_USE_UV" != 0 ] && command -v uv >/dev/null 2>&1; then
    uv venv -q --seed --python "${KI_PY:-/usr/bin/python3}" "$v" && exit 0
    [ -n "$KI_PY" ] && exit 1
    echo "ki: uv konnte das .venv nicht anlegen (offline?) – nehme python3 -m venv." >&2
    rm -rf "$v"
    python3 -m venv "$v"
elif [ -n "$KI_PY" ]; then
    echo "ki: Python $KI_PY braucht uv (bootstrap.sh --only uv)." >&2; exit 1
else
    python3 -m venv "$v"
fi'

# Installiert Pakete im Kerker – mit uv (schnell, Hardlinks statt Doppelkopie) oder pip
PIP_SCRIPT='if [ "$KI_USE_UV" != 0 ] && command -v uv >/dev/null 2>&1; then exec uv pip install "$@"; else exec pip install "$@"; fi'

# Läuft im Kerker um PyCharm herum. Startet PyCharm sich selbst neu (Plugins, Updates),
# übergibt es an den "restarter" und beendet sich. Würde der Kerker jetzt enden, stürbe der
# Neustart mit (B8). Darum bleibt er offen, solange IDE oder Restarter noch laufen.
IDE_WRAPPER='
"$@"; rc=$?
sleep 2
while pgrep -x "java|pycharm|restarter" >/dev/null 2>&1; do sleep 2; done
exit $rc'

write_bashrc() {
    cat > "$1/.bashrc" <<'EOF'
# Von ki erzeugt und bei jedem Start erneuert – eigene Ergänzungen in ~/.bashrc.local
HISTFILE="$HOME/.bash_history"; HISTSIZE=5000; HISTCONTROL=ignoredups:erasedups
alias ls='ls --color=auto' ll='ls -alF' grep='grep --color=auto'
PS1='\[\e[38;5;173m\][${KI_PROJECT}]\[\e[0m\] \w \$ '
if [ -z "${KI_JOB:-}" ] && [ -z "${TERMINAL_EMULATOR:-}" ]; then
    printf '\e[2mKerker %s · %s · Code in ~/code · exit = zurück\e[0m\n' "$KI_PROJECT" "$(python -V 2>&1)"
    command -v uv >/dev/null 2>&1 && [ "${KI_USE_UV:-auto}" != 0 ] &&
        printf '\e[2mPakete schnell installieren: uv pip install <paket>\e[0m\n'
fi
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
EOF
}

# Ordner, .bashrc und .venv sicherstellen
prepare_project() {
    local name=$1 P rc
    P=$(proj_dir "$name")
    mkdir -p "$P/code" "$P/.system_cache" "$P/.ki/jobs" || return 1
    write_bashrc "$P"
    touch "$P/.ki/last-used"
    KERKER_ENV=(--setenv KI_PY "$(cat "$P/.ki/python" 2>/dev/null)")
    kerker_run "$name" shell /bin/sh -c "$VENV_SCRIPT"
    rc=$?
    KERKER_ENV=()
    return $rc
}

pycharm_launcher() {
    if [ -x "$KI_PYCHARM/bin/pycharm" ]; then echo "$KI_PYCHARM/bin/pycharm"
    elif [ -x "$KI_PYCHARM/bin/pycharm.sh" ]; then echo "$KI_PYCHARM/bin/pycharm.sh"
    else
        warn "PyCharm nicht gefunden unter $KI_PYCHARM. Installieren: ki pycharm-update"
        return 1
    fi
}

# Speicherobergrenze für PyCharm setzen, falls noch keine eigene existiert.
# Ändern geht danach auch in PyCharm: Help → Change Memory Settings.
ensure_vmoptions() {
    local dd f
    dd=$(sed -n 's/.*"dataDirectoryName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$KI_PYCHARM/product-info.json" 2>/dev/null | head -n1)
    [ -n "$dd" ] || return 0
    f="$HOME/.config/JetBrains/$dd/pycharm64.vmoptions"
    [ -f "$f" ] && return 0
    mkdir -p "${f%/*}"
    printf -- '-Xmx%s\n-XX:+UseStringDeduplication\n' "$KI_IDE_XMX" > "$f"
}

# ------------------------------------------------------------------ Befehle
cmd_new() {
    local name="" profile=py py="" torch=0 next="" P
    while [ $# -gt 0 ]; do
        case $1 in
            -p|--profile) [ $# -ge 2 ] || die "$1 braucht einen Wert"; profile=$2; shift 2 ;;
            --python)     [ $# -ge 2 ] || die "$1 braucht einen Wert"; py=$2; shift 2 ;;
            --torch)      torch=1; shift ;;
            --open)       next=open; shift ;;
            --shell)      next=shell; shift ;;
            -*)           die "Unbekannte Option: $1" ;;
            *)            [ -z "$name" ] || die "Nur ein Projektname erlaubt."; name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "Aufruf: ki new <name> [--profile ml|py|node] [--python 3.12] [--torch] [--open|--shell]"
    valid_name "$name" || die "Ungültiger Name '$name' (erlaubt: a-z A-Z 0-9 - _, max. 64 Zeichen)."
    case $profile in ml|py|node) ;; *) die "Profil '$profile' unbekannt (ml, py, node)." ;; esac
    P=$(proj_dir "$name")
    [ -e "$P" ] && die "'$name' gibt es schon."

    mkdir -p "$P/code" "$P/.ki/jobs" "$P/.system_cache" || die "Kann $P nicht anlegen."
    echo "$profile" > "$P/.ki/profile"
    [ -n "$py" ] && echo "$py" > "$P/.ki/python"
    if [ -d "$KI_TEMPLATES" ]; then
        [ -f "$KI_TEMPLATES/common/gitignore" ] && cp "$KI_TEMPLATES/common/gitignore" "$P/code/.gitignore"
        [ -d "$KI_TEMPLATES/$profile" ] && cp -r "$KI_TEMPLATES/$profile/." "$P/code/"
        sed -i "s/@NAME@/$name/g" "$P/code/README.md" "$P/code/package.json" 2>/dev/null
    fi
    if command -v git >/dev/null 2>&1; then
        git -C "$P/code" init -q -b main 2>/dev/null || git -C "$P/code" init -q
    fi
    info "Lege Python-Umgebung an …"
    prepare_project "$name" || die "Python-Umgebung konnte nicht angelegt werden (Projektordner bleibt: $P)."
    if [ "$profile" = node ] && ! command -v node >/dev/null 2>&1; then
        warn "Node.js ist nicht installiert: ./bootstrap.sh --only node"
    fi
    if [ "$torch" = 1 ] && [ -f "$P/code/requirements.txt" ]; then
        info "Installiere requirements.txt (PyTorch bringt seine CUDA-Bibliotheken selbst mit) …"
        kerker_run "$name" shell /bin/sh -c "$PIP_SCRIPT" ki-pip -r requirements.txt ||
            warn "Installation fehlgeschlagen – später im Projekt-Terminal wiederholen."
    fi
    info "Projekt '$name' angelegt ($profile): $P"
    case $next in
        open)  cmd_open "$name" ;;
        shell) cmd_shell "$name" ;;
    esac
}

cmd_open() {
    local name=${1:-} running
    need_project "$name"; need_new_layout "$name"
    [ -n "${DISPLAY:-}" ] || die "PyCharm braucht die Oberfläche. Per SSH gehen: ki shell, ki run, ki jupyter."
    if running=$(ide_project); then
        if [ "$running" = "$name" ]; then
            i3msg workspace number "$KI_IDE_WS"
            info "PyCharm mit '$name' läuft bereits (Arbeitsfläche $KI_IDE_WS)."
            return 0
        fi
        die "PyCharm läuft bereits mit '$running'. Erst dort schließen – eine IDE gleichzeitig spart 1,5–2 GB RAM."
    fi
    pycharm_launcher >/dev/null || exit 1
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    ensure_vmoptions
    if [ "${KI_FOREGROUND:-0}" = 1 ]; then
        cmd__ide "$name"
    fi
    setsid -f "$SELF" _ide "$name" </dev/null >/dev/null 2>&1
    info "PyCharm startet mit '$name' auf Arbeitsfläche $KI_IDE_WS – zurück zum Menü: Win+$KI_MENU_WS"
}

# Intern: hält die IDE-Sperre, startet PyCharm im Kerker und holt danach das Menü zurück
cmd__ide() {
    local name=$1 P launcher rc
    P=$(proj_dir "$name")
    mkdir -p "$KI_RUN"
    exec 9>"$KI_RUN/ide.lock"
    flock -n 9 || die "PyCharm läuft bereits."
    printf '%s\n' "$name" > "$KI_RUN/ide.project"
    launcher=$(pycharm_launcher) || exit 1
    i3msg workspace number "$KI_IDE_WS"
    printf '# PyCharm-Start %s · Projekt %s\n' "$(date '+%F %T')" "$name" > "$P/.ki/ide.log"
    kerker_run "$name" gui /bin/sh -c "$IDE_WRAPPER" ki-ide "$launcher" "$HOME/code" >>"$P/.ki/ide.log" 2>&1
    rc=$?
    printf '# Ende %s · Exit-Code %s\n' "$(date '+%F %T')" "$rc" >> "$P/.ki/ide.log"
    rm -f "$KI_RUN/ide.project"
    i3msg workspace number "$KI_MENU_WS"
    exit "$rc"
}

cmd_shell() {
    local name=${1:-}
    need_project "$name"; need_new_layout "$name"; shift
    [ "${1:-}" = -- ] && shift
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    [ $# -gt 0 ] || set -- bash
    kerker_run "$name" shell "$@"
}

cmd_run() {
    local name=${1:-} id dir label
    need_project "$name"; need_new_layout "$name"; shift
    case ${1:-} in
        --sh) [ -n "${2:-}" ] || die "--sh braucht eine Befehlszeile"; label=$2; set -- bash -c "$2" ;;
        --)   shift; label="$*" ;;
        *)    label="$*" ;;
    esac
    [ $# -gt 0 ] || die "Aufruf: ki run <projekt> -- <befehl …>   oder   ki run <projekt> --sh \"befehlszeile\""
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    dir=$(job_dir "$name")
    id=$(date +%Y%m%d-%H%M%S)
    [ -e "$dir/$id.cmd" ] && { sleep 1; id=$(date +%Y%m%d-%H%M%S); }
    printf '%s\n' "$label" > "$dir/$id.cmd"
    setsid -f "$SELF" _job "$name" "$id" "$@" </dev/null >"$dir/$id.log" 2>&1
    info "Job $id läuft im Hintergrund (auch nach SSH-Abmeldung)."
    say_hint "Log:   ki logs $name"
    say_hint "Stopp: ki stop $name $id"
}
say_hint() { printf '  %s%s%s\n' "$C_DIM" "$*" "$C_0"; }

# Intern: läuft als eigene Sitzung (setsid), PID = Prozessgruppe des Jobs
cmd__job() {
    local name=$1 id=$2 dir rc; shift 2
    dir=$(job_dir "$name")
    echo $$ > "$dir/$id.pid"
    trap 'echo "# SIGTERM erhalten"' TERM
    printf '# ki-Job %s · Projekt %s · Start %s\n# Befehl: %s\n\n' "$id" "$name" "$(date '+%F %T')" "$(cat "$dir/$id.cmd")"
    KERKER_ENV=(--setenv PYTHONUNBUFFERED 1 --setenv KI_JOB "$id")
    kerker_run "$name" shell "$@"
    rc=$?
    echo "$rc" > "$dir/$id.exit"
    rm -f "$dir/$id.pid"
    printf '\n# Ende %s · Exit-Code %s\n' "$(date '+%F %T')" "$rc"
    exit "$rc"
}

cmd_jobs() {
    local porcelain=0 n id st list
    [ "${1:-}" = --porcelain ] && { porcelain=1; shift; }
    if [ -n "${1:-}" ]; then need_project "$1"; list=$1; else list=$(projects); fi
    for n in $list; do
        for id in $(job_ids "$n" | head -n 10); do
            st=$(job_state "$n" "$id")
            if [ $porcelain = 1 ]; then
                printf '%s\t%s\t%s\t%s\n' "$n" "$id" "$st" "$(head -c 200 "$(job_dir "$n")/$id.cmd")"
            else
                case $st in läuft) st="${C_OK}$st${C_0}" ;; fertig) ;; *) st="${C_ERR}$st${C_0}" ;; esac
                printf '%-20s %-16s %-40s %s\n' "$n" "$id" "$(head -c 40 "$(job_dir "$n")/$id.cmd")" "$st"
            fi
        done
    done
}

cmd_logs() {
    local name=${1:-} id=${2:-} f
    need_project "$name"
    [ -n "$id" ] || id=$(job_ids "$name" | head -n1)
    [ -n "$id" ] || die "Keine Jobs in '$name'."
    f="$(job_dir "$name")/$id.log"
    [ -f "$f" ] || die "Kein Log für Job $id."
    if [ ! -t 1 ]; then cat "$f"
    elif [ "$(job_state "$name" "$id")" = "läuft" ]; then less -R +F "$f"   # Strg+C stoppt Mitlaufen, q beendet
    else less -R +G "$f"
    fi
}

cmd_stop() {
    local name=${1:-} id=${2:-} pid
    need_project "$name"
    if [ -z "$id" ]; then
        id=$(running_jobs "$name")
        [ -n "$id" ] || { info "In '$name' läuft kein Job."; return 0; }
        [ "$(printf '%s\n' "$id" | wc -l)" -eq 1 ] || die "Mehrere Jobs laufen – ID angeben: $(echo "$id" | tr '\n' ' ')"
    fi
    pid=$(cat "$(job_dir "$name")/$id.pid" 2>/dev/null)
    job_alive "$pid" || { info "Job $id läuft nicht."; return 0; }
    # Wie Strg+C: das Programm darf aufräumen (Checkpoint speichern)
    info "Stoppe Job $id – das Programm bekommt Strg+C und darf aufräumen …"
    kill -INT -- "-$pid" 2>/dev/null
    for _ in $(seq 30); do job_alive "$pid" || { info "Job $id beendet."; return 0; }; sleep 1; done
    warn "Keine Reaktion nach 30 s – beende hart."
    kill -TERM -- "-$pid" 2>/dev/null; sleep 3
    job_alive "$pid" && kill -KILL -- "-$pid" 2>/dev/null
    info "Job $id beendet."
}

cmd_jupyter() {
    local name=${1:-} port=${2:-$KI_JUPYTER_PORT} ip
    need_project "$name"; need_new_layout "$name"
    prepare_project "$name" || die "Projekt '$name' konnte nicht vorbereitet werden."
    if [ ! -x "$(proj_dir "$name")/code/.venv/bin/jupyter" ]; then
        info "JupyterLab fehlt im Projekt – wird installiert …"
        kerker_run "$name" shell /bin/sh -c "$PIP_SCRIPT" ki-pip jupyterlab || die "Installation fehlgeschlagen."
    fi
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    printf '%s\n' "${C_B}JupyterLab für '$name'${C_0} – nur lokal auf Port $port, Zugriff per SSH-Tunnel:" \
        "  Auf dem Zweitrechner:  ssh -N -L $port:127.0.0.1:$port $(id -un)@${ip:-<IP>}" \
        "  Dann die unten stehende Adresse http://127.0.0.1:$port/lab?token=… im Browser öffnen." \
        "  Beenden: Strg+C" ""
    kerker_run "$name" shell jupyter lab --no-browser --ip=127.0.0.1 --port="$port" \
        --ServerApp.root_dir="$HOME/code"
}

cmd_list() {
    local porcelain=0 size=0 n prof last st sz ide
    while [ $# -gt 0 ]; do
        case $1 in --porcelain) porcelain=1 ;; --size) size=1 ;; *) die "Unbekannte Option: $1" ;; esac
        shift
    done
    ide=$(ide_project 2>/dev/null)
    projects_by_use | while IFS= read -r n; do
        prof=$(proj_profile "$n"); last=$(proj_last_used "$n"); st=""; sz=""
        is_old_layout "$n" && st="altes Layout"
        [ "$ide" = "$n" ] && st="PyCharm"
        [ -n "$(running_jobs "$n")" ] && st="${st:+$st, }Job"
        [ $size = 1 ] && sz=$(du -sh "$(proj_dir "$n")" 2>/dev/null | cut -f1)
        if [ $porcelain = 1 ]; then
            printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$prof" "$last" "$st" "$sz"
        else
            printf '%-22s %-5s %-14s %6s  %s\n' "$n" "$prof" "$(rel_time "$last")" "$sz" "${st:+${C_ACC}$st${C_0}}"
        fi
    done
}

cmd_caches() {   # Cache-Ordner eines Projekts mit Größe
    local name=${1:-} d
    need_project "$name"
    for d in "$(proj_dir "$name")/.system_cache"/*/; do
        printf '%s\t%s\n' "$(basename "$d")" "$(du -sh "$d" 2>/dev/null | cut -f1)"
    done
}

clean_project() {
    local name=$1 c before after d dirs=() x; shift
    c="$(proj_dir "$name")/.system_cache"
    [ -d "$c" ] || return 0
    if project_busy "$name"; then warn "'$name' wird gerade benutzt – Cache bleibt."; return 1; fi
    if [ $# -gt 0 ]; then for x in "$@"; do dirs+=("$c/$x/"); done; else dirs=("$c"/*/); fi
    before=$(du -sb "$c" 2>/dev/null | cut -f1)
    for d in "${dirs[@]}"; do
        [ -d "$d" ] || continue
        chmod -R u+w "$d" 2>/dev/null
        find "$d" -mindepth 1 -delete 2>/dev/null
    done
    after=$(du -sb "$c" 2>/dev/null | cut -f1)
    info "$name: $(human $(( ${before:-0} - ${after:-0} ))) freigegeben"
}

cmd_clean() {
    local n
    if [ "${1:-}" = --all ]; then
        for n in $(projects); do clean_project "$n"; done
        return 0
    fi
    need_project "${1:-}"
    n=$1; shift
    clean_project "$n" "$@"
}

cmd_rm() {
    local name=${1:-} answer
    need_project "$name"
    project_busy "$name" && die "'$name' wird gerade benutzt (PyCharm oder Job)."
    if [ "${2:-}" != --yes ]; then
        [ -t 0 ] || die "Löschen ohne Rückfrage nur mit --yes."
        printf 'Projekt %s mit Code, .venv, Caches und Modellen endgültig löschen?\nZum Bestätigen den Namen eingeben: ' "$name"
        read -r answer
        [ "$answer" = "$name" ] || die "Abgebrochen."
    fi
    rm -rf -- "$(proj_dir "$name")" || die "Löschen fehlgeschlagen."
    info "Projekt '$name' gelöscht."
}

cmd_mv() {
    local old=${1:-} new=${2:-}
    need_project "$old"
    valid_name "$new" || die "Ungültiger neuer Name '$new'."
    [ -e "$(proj_dir "$new")" ] && die "'$new' gibt es schon."
    project_busy "$old" && die "'$old' wird gerade benutzt."
    # Im Kerker ist jedes Projekt ~ – Umbenennen bricht keine Pfade
    mv -- "$(proj_dir "$old")" "$(proj_dir "$new")" && info "'$old' heißt jetzt '$new'."
}

# Altes Layout (Code direkt im Projektordner) → Code nach code/
is_code_dotfile() {
    case $1 in
        .git|.gitignore|.gitattributes|.gitmodules|.github|.gitlab-ci.yml|.env|.env.*|.editorconfig|\
        .pre-commit-config.yaml|.python-version|.flake8|.pylintrc|.ruff.toml|.isort.cfg|.coveragerc|\
        .vscode|.dockerignore|.prettierrc*|.eslintrc*|.nvmrc|.npmrc|.babelrc) return 0 ;;
    esac
    return 1
}
migrate_one() {
    local name=$1 P e base n=0 prof esc
    P=$(proj_dir "$name")
    is_old_layout "$name" || { info "'$name' hat schon das neue Layout."; return 0; }
    project_busy "$name" && { warn "'$name' wird gerade benutzt – übersprungen."; return 1; }
    info "Migriere '$name' …"
    mkdir -p "$P/code" "$P/.ki/jobs"
    for e in "$P"/* "$P"/.[!.]* "$P"/..?*; do
        base=${e##*/}
        case $base in
            code|shared_data) continue ;;   # shared_data ist nur ein Mountpunkt des Kerkers
            .*) is_code_dotfile "$base" || continue ;;
        esac
        mv -- "$e" "$P/code/" && n=$((n + 1))
    done
    # .venv mitnehmen; venvs enthalten absolute Pfade in Skripten und activate
    if [ -d "$P/.venv" ] && [ ! -e "$P/code/.venv" ]; then
        mv "$P/.venv" "$P/code/.venv"
        esc=${HOME//./\\.}
        grep -rlIZ -F "$HOME/.venv" "$P/code/.venv/bin" "$P/code/.venv/pyvenv.cfg" 2>/dev/null |
            xargs -0 -r sed -i "s#$esc/\\.venv#$HOME/code/.venv#g"
    fi
    # Alte .idea hatte die falsche Projektwurzel (B3) – aufheben statt löschen
    [ -d "$P/.idea" ] && mv "$P/.idea" "$P/.ki/idea-alt"
    if [ -f "$P/.system_cache/.profile" ]; then
        case $(tr '[:upper:]' '[:lower:]' < "$P/.system_cache/.profile") in
            *ml*|*ki*|*torch*) prof=ml ;;
            *node*|*js*)       prof=node ;;
            *)                 prof=py ;;
        esac
        echo "$prof" > "$P/.ki/profile"
        rm -f "$P/.system_cache/.profile"
    fi
    [ -f "$P/.system_cache/pycharm/last-run.log" ] && mv "$P/.system_cache/pycharm/last-run.log" "$P/.ki/ide.log"
    info "'$name': $n Einträge nach code/ verschoben${prof:+, Profil $prof}."
    [ -d "$P/.ki/idea-alt" ] && say_hint "Alte PyCharm-Projektdateien liegen in .ki/idea-alt (Run-Konfigurationen bei Bedarf übernehmen)."
    return 0
}
cmd_migrate() {
    local n found=0
    if [ "${1:-}" = --all ]; then
        for n in $(projects); do
            is_old_layout "$n" && { found=1; migrate_one "$n"; }
        done
        [ $found = 1 ] || info "Alle Projekte haben schon das neue Layout."
        return 0
    fi
    need_project "${1:-}"
    migrate_one "$1"
}

power_mode() {
    local g
    g=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null) || { echo "unbekannt"; return; }
    if [ "$g" = performance ]; then echo "Leistung"; else echo "ausgewogen"; fi
}
cmd_power() {
    case ${1:-status} in
        status) power_mode ;;
        performance|leistung) sudo -n /usr/local/sbin/ki-power performance >/dev/null ||
                                  die "ki-power nicht eingerichtet (./bootstrap.sh --only sudoers)."
                              info "CPU-Modus: $(power_mode)" ;;
        balanced|ausgewogen)  sudo -n /usr/local/sbin/ki-power balanced >/dev/null ||
                                  die "ki-power nicht eingerichtet (./bootstrap.sh --only sudoers)."
                              info "CPU-Modus: $(power_mode)" ;;
        *) die "Aufruf: ki power [performance|balanced]" ;;
    esac
}

gpu_line() {
    command -v nvidia-smi >/dev/null 2>&1 || return 1
    nvidia-smi --query-gpu=memory.used,memory.total,temperature.gpu,utilization.gpu,power.draw \
        --format=csv,noheader,nounits 2>/dev/null |
        awk -F', *' 'NR==1 {printf "%.1f / %.1f GiB VRAM · %s °C · %s %% Last · %s W\n", $1/1024, $2/1024, $3, $4, $5}'
}

cmd_status() {
    local ide n id g
    printf '%sRAM%s    ' "$C_B" "$C_0"
    free -m | awk '/^Mem:/ {printf "%.1f / %.1f GiB belegt, %.1f GiB verfügbar\n", $3/1024, $2/1024, $7/1024}'
    printf '%sSwap%s   ' "$C_B" "$C_0"
    swapon --show=NAME,SIZE,USED --noheadings 2>/dev/null | awk '{printf "%s %s (%s belegt)  ", $1, $2, $3} END {if (NR==0) printf "keiner"; print ""}'
    if g=$(gpu_line); then printf '%sGPU%s    %s\n' "$C_B" "$C_0" "$g"; fi
    printf '%sSSD%s    ' "$C_B" "$C_0"; df -h --output=avail,size / | awk 'NR==2 {print $1 " frei von " $2}'
    printf '%sCPU%s    Modus %s · Last %s\n' "$C_B" "$C_0" "$(power_mode)" "$(cut -d' ' -f1-3 /proc/loadavg)"
    ide=$(ide_project 2>/dev/null) && printf '%sIDE%s    PyCharm mit %s\n' "$C_B" "$C_0" "$ide"
    for n in $(projects); do
        for id in $(running_jobs "$n"); do
            printf '%sJob%s    %s %s: %s\n' "$C_B" "$C_0" "$n" "$id" "$(head -c 60 "$(job_dir "$n")/$id.cmd")"
        done
    done
}

cmd_doctor() {
    local n_err=0 n_warn=0 v f out uidn lst
    ok()   { printf '  %s✔%s %s\n' "$C_OK" "$C_0" "$*"; }
    bad()  { printf '  %s✘%s %s\n' "$C_ERR" "$C_0" "$1"; [ -n "${2:-}" ] && say_hint "  → $2"; n_err=$((n_err + 1)); }
    hint() { printf '  %s!%s %s\n' "$C_ACC" "$C_0" "$1"; [ -n "${2:-}" ] && say_hint "  → $2"; n_warn=$((n_warn + 1)); }
    sect() { printf '\n%s%s%s\n' "$C_B" "$*" "$C_0"; }

    sect "System"
    # shellcheck source=/dev/null
    v=$( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-?}")
    ok "$v · Kernel $(uname -r)"

    sect "GPU"
    if ! command -v nvidia-smi >/dev/null 2>&1; then
        bad "nvidia-smi fehlt" "./bootstrap.sh --only nvidia"
    elif ! out=$(nvidia-smi --query-gpu=name,driver_version,persistence_mode,display_active,memory.used \
                 --format=csv,noheader,nounits 2>&1); then
        bad "Treiber antwortet nicht: $out" "sudo ubuntu-drivers install, Neustart; nach Kernel-Update: dkms status"
    else
        IFS=',' read -r v f _ _ _ <<< "$out"; ok "$v · Treiber${f}"
        if [[ $(cut -d, -f3 <<< "$out") == *Enabled* ]]; then ok "Persistence Mode an (schneller CUDA-Start)"
        else hint "Persistence Mode aus – jeder CUDA-Start initialisiert die Karte neu" "./bootstrap.sh --only nvidia"; fi
        if [[ $(cut -d, -f4 <<< "$out") == *Enabled* ]]; then
            hint "Bildschirm hängt an der RTX – Xorg belegt VRAM ($(cut -d, -f5 <<< "$out" | tr -d ' ') MiB gesamt belegt)" \
                 "Monitor ans Mainboard + ./bootstrap.sh --only igpu (siehe docs/SYSTEM.md)"
        else ok "RTX ist frei von Grafikausgabe – voller VRAM für CUDA"; fi
    fi

    sect "Kerker & Werkzeuge"
    if ! command -v bwrap >/dev/null 2>&1; then bad "bubblewrap fehlt" "sudo apt install bubblewrap"
    elif out=$(bwrap --unshare-user --uid "$(id -u)" --gid "$(id -g)" --ro-bind / / true 2>&1); then ok "bwrap mit User-Namespace"
    else bad "bwrap scheitert: $out" "./bootstrap.sh --only bwrap (AppArmor-Profil)"; fi
    if use_uv; then ok "uv $(uv --version 2>/dev/null | cut -d' ' -f2)"
    else hint "uv fehlt – Installationen sind langsamer, Pakete liegen doppelt (pip-Cache + .venv)" "./bootstrap.sh --only uv"; fi
    if f=$(pycharm_launcher 2>/dev/null); then
        v=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$KI_PYCHARM/product-info.json" 2>/dev/null | head -n1)
        ok "PyCharm ${v:-?} ($(readlink -f "$KI_PYCHARM"))"
    else bad "PyCharm fehlt unter $KI_PYCHARM" "ki pycharm-update"; fi
    if command -v gum >/dev/null 2>&1; then ok "gum $(gum --version 2>/dev/null | awk '{print $NF}')"
    else hint "gum fehlt – Menü läuft im Notfallmodus" "./bootstrap.sh --only gum"; fi

    sect "Autostart"
    if grep -qs -- "--autologin $(id -un)" /etc/systemd/system/getty@tty1.service.d/autologin.conf; then ok "Autologin auf tty1"
    else hint "kein Autologin auf tty1" "./bootstrap.sh --only autologin"; fi
    if grep -qs '/dev/tty1' "$HOME/.bash_profile" && ! grep -qs $'\r' "$HOME/.bash_profile"; then ok "~/.bash_profile startet X auf tty1"
    else bad "~/.bash_profile fehlt, falsch oder hat Windows-Zeilenenden" "./install.sh"; fi
    if grep -qs 'xrdb' "$HOME/.xinitrc"; then ok "~/.xinitrc lädt die Farben vor dem ersten Fenster (B2)"
    else bad "~/.xinitrc ohne xrdb (B2)" "./install.sh"; fi
    if [ -n "${DISPLAY:-}" ]; then
        if xrdb -query 2>/dev/null | grep -qi 'background:.*#2B2B2B'; then ok "Farbschema geladen"
        else hint "Farbschema nicht geladen" "xrdb -merge ~/.Xresources"; fi
        if i3-msg -t get_tree 2>/dev/null | grep -q '"instance":"ki-menu"'; then ok "Menü-Fenster vorhanden"
        else hint "Menü-Fenster nicht gefunden" "i3-msg restart"; fi
    fi

    sect "Speicher"
    ok "$(free -m | awk '/^Mem:/ {printf "RAM %.1f GiB, davon %.1f GiB verfügbar", $2/1024, $7/1024}')"
    lst=$(swapon --show=NAME,TYPE --noheadings 2>/dev/null)
    if grep -q zram <<< "$lst"; then ok "zram-Swap aktiv (komprimierter RAM statt SSD-Swap)"
    else hint "kein zram – bei RAM-Knappheit wird auf die SSD geswappt (zäh)" "./bootstrap.sh --only speicher"; fi
    grep -qv zram <<< "$lst" && grep -q . <<< "$lst" &&
        hint "zusätzlich Swap auf der SSD: $(grep -v zram <<< "$lst" | awk '{print $1}' | tr '\n' ' ')" "./bootstrap.sh --only speicher"
    if systemctl is-active --quiet earlyoom 2>/dev/null; then ok "earlyoom schützt vor Einfrieren bei RAM-Mangel"
    else hint "earlyoom läuft nicht – ein zu großes Training kann das System minutenlang einfrieren" "./bootstrap.sh --only speicher"; fi
    v=$(df --output=avail -BG / | tail -n1 | tr -dc '0-9')
    if [ "${v:-0}" -lt 30 ]; then bad "nur ${v} GiB frei auf /" "ki clean --all oder alte Projekte löschen"; else ok "${v} GiB frei auf /"; fi
    v=$(du -sm "$HOME/.cache" 2>/dev/null | cut -f1)
    if [ "${v:-0}" -gt 500 ]; then hint "Host-Cache ~/.cache ist ${v} MiB groß – schreibt etwas am Kerker vorbei?" "du -sh ~/.cache/* | sort -h"
    else ok "Host bleibt sauber (~/.cache ${v:-0} MiB)"; fi

    sect "Netz"
    for f in https://pypi.org/simple/ https://download.jetbrains.com/; do
        v=$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 "$f" 2>/dev/null)
        case $v in 2*|3*) ok "$f erreichbar" ;; *) hint "$f nicht erreichbar (HTTP ${v:-–})" "IPv6-Problem? ./bootstrap.sh --only netz; Uhrzeit: timedatectl" ;; esac
    done

    sect "Projekte"
    f=0
    for v in $(projects); do
        is_old_layout "$v" && { f=$((f + 1)); hint "'$v' hat das alte Layout" "ki migrate $v"; }
    done
    [ $f = 0 ] && ok "$(projects | wc -l) Projekte im neuen Layout"
    uidn=$(id -u)
    out=$(pgrep -u "$uidn" -x bwrap 2>/dev/null | wc -l)
    ok "$out Kerker aktiv${C_DIM} (PyCharm: $(ide_project 2>/dev/null || echo –))${C_0}"

    printf '\n'
    if [ $n_err -eq 0 ] && [ $n_warn -eq 0 ]; then info "Alles in Ordnung."
    else info "$n_err Fehler, $n_warn Hinweise."; fi
    [ $n_err -eq 0 ]
}

cmd_update() {
    local repo
    repo=$(cat "$KI_CONFIG_DIR/repo" 2>/dev/null) || repo="$HOME/SetUp"
    [ -d "$repo/.git" ] || die "Setup-Repo nicht gefunden ($repo)."
    git -C "$repo" pull --ff-only || die "git pull fehlgeschlagen – lokale Änderungen? git -C $repo status"
    "$repo/install.sh"
}

latest_pycharm() {   # gibt "Download-Link Prüfsummen-Link" der aktuellen Version aus
    curl -fsS --max-time 20 'https://data.services.jetbrains.com/products/releases?code=PCP&latest=true&type=release' 2>/dev/null |
        python3 -c '
import json, sys
data = json.load(sys.stdin)
release = next(iter(data.values()))[0]
linux = release["downloads"]["linux"]
print(linux["link"], linux.get("checksumLink", ""))' 2>/dev/null
}

cmd_pycharm_update() {
    local src=${1:-} sumurl="" tmp file top cur want have
    if ide_project >/dev/null 2>&1; then die "Erst PyCharm schließen."; fi
    mkdir -p "$KI_STATE"
    tmp=$(mktemp -d "$KI_STATE/pycharm.XXXXXX") || die "Kein Platz für den Download."
    trap 'rm -rf "$tmp"' EXIT
    if [ -z "$src" ]; then
        info "Frage aktuelle PyCharm-Version bei JetBrains ab …"
        read -r src sumurl < <(latest_pycharm)
        [ -n "$src" ] || die "Keine Version gefunden. Link (Linux, .tar.gz) von https://www.jetbrains.com/pycharm/download/ kopieren: ki pycharm-update <link>"
    fi
    case $src in
        http://*|https://*)
            file="$tmp/${src##*/}"
            info "Lade ${src##*/} …"
            curl -fL --progress-bar -o "$file" "$src" || die "Download fehlgeschlagen (IPv6? ./bootstrap.sh --only netz)."
            [ -n "$sumurl" ] || sumurl="$src.sha256"
            want=$(curl -fsS --max-time 20 "$sumurl" 2>/dev/null | awk '{print $1}')
            if [ -n "$want" ]; then
                have=$(sha256sum "$file" | awk '{print $1}')
                [ "$want" = "$have" ] || die "Prüfsumme stimmt nicht – Download beschädigt."
                info "Prüfsumme in Ordnung."
            fi ;;
        *)  [ -f "$src" ] || die "Datei nicht gefunden: $src"; file=$src ;;
    esac
    top=$(tar -tzf "$file" 2>/dev/null | head -n1 | cut -d/ -f1)
    [[ $top == pycharm-* ]] || die "Kein PyCharm-Archiv ($file)."
    cur=$(readlink -f "$KI_PYCHARM" 2>/dev/null)
    if [ -d "/opt/$top" ]; then
        info "/opt/$top ist schon entpackt."
    else
        info "Entpacke nach /opt/$top (sudo) …"
        sudo tar -xzf "$file" -C /opt || die "Entpacken fehlgeschlagen."
    fi
    sudo ln -sfn "/opt/$top" "$KI_PYCHARM" || die "Symlink $KI_PYCHARM konnte nicht gesetzt werden."
    info "PyCharm → /opt/$top"
    if [ -n "$cur" ] && [ "$cur" != "/opt/$top" ]; then
        say_hint "Alte Version bleibt bis zum Test: $cur  (danach: sudo rm -rf $cur)"
    fi
}

cmd_top() {
    if command -v nvtop >/dev/null 2>&1; then exec nvtop; fi
    if command -v htop >/dev/null 2>&1; then exec htop; fi
    exec top
}

# Für das Menü: kompakter Zustand in einem Aufruf
cmd__state() {
    local n last="" jobs=0 old=0 ide
    ide=$(ide_project 2>/dev/null)
    for n in $(projects_by_use); do
        if is_old_layout "$n"; then old=$((old + 1)); continue; fi
        [ -n "$last" ] || last=$n
        jobs=$((jobs + $(running_jobs "$n" | grep -c .)))
    done
    printf 'ide=%s\nlast=%s\njobs=%s\nold=%s\npower=%s\nide_ws=%s\nmenu_ws=%s\nextra_ws=%s\nprojects=%s\n' \
        "$ide" "$last" "$jobs" "$old" "$(power_mode)" "$KI_IDE_WS" "$KI_MENU_WS" "$KI_EXTRA_WS" "$KI_PROJECTS"
}
cmd__lastcmd() {
    local id; id=$(job_ids "$1" | head -n1)
    [ -n "$id" ] && cat "$(job_dir "$1")/$id.cmd"
}

cmd_help() {
    cat <<EOF
${C_B}ki $KI_VERSION – Projektwerkzeug der KI-Workstation${C_0}

${C_B}Projekte${C_0}
  ki new <name> [--profile ml|py|node] [--torch] [--python 3.12] [--open|--shell]
  ki open <name>              PyCharm im Kerker (Arbeitsfläche $KI_IDE_WS)
  ki shell <name> [befehl…]   Terminal/Befehl im Kerker, ohne IDE (spart 1,5–2 GB RAM)
  ki list [--size]            Projekte, zuletzt benutzte zuerst
  ki clean <name> [ordner…]   Cache leeren (alle Unterordner oder z. B. pip huggingface)
  ki clean --all
  ki mv <alt> <neu>           umbenennen      ki rm <name>   löschen
  ki migrate <name>|--all     altes Layout (v1) → Code nach code/

${C_B}Training & KI${C_0}
  ki run <name> -- python train.py      Job im Hintergrund (überlebt SSH-Abmeldung)
  ki run <name> --sh "befehlszeile"     dito, als Shell-Befehlszeile
  ki jobs [name]   ki logs <name> [id]   ki stop <name> [id]   (Stopp = Strg+C, dann hart)
  ki jupyter <name> [port]              JupyterLab für den Browser auf dem Zweitrechner
  ki top                                GPU-/CPU-Monitor (nvtop)
  ki power [performance|balanced]       CPU-Leistungsmodus

${C_B}System${C_0}
  ki status   ki doctor   ki update (Setup-Repo + install.sh)   ki pycharm-update [link|datei]

${C_B}Tasten${C_0} (Win = Super-Taste, kollidiert nicht mit PyCharm)
  Win+1 Menü   Win+2 PyCharm   Win+3 Extra   Win+Tab zuletzt benutzte Arbeitsfläche
  Win+Enter Host-Terminal   Win+Shift+Q Fenster schließen   Win+F Vollbild
  Win+G GPU-Monitor   Win+Shift+R i3 neu laden
  Terminal: Strg+Bild↑/↓ (oder Strg+Plus/Minus), Strg+0 Schriftgröße   Strg+Shift+C/V kopieren/einfügen

${C_B}Pfade im Kerker${C_0}
  ~ = ~/projects/<name>   ~/code = dein Code   ~/code/.venv = Python   ~/shared_data = Datensätze (nur lesen)
  Eigene Umgebungsvariablen: ~/projects/<name>/.ki/env  (Zeilen KEY=Wert)
EOF
}

# ------------------------------------------------------------------ Verteiler
if [ -n "${KI_PROJECT:-}" ] && [ "${1:-}" != help ]; then
    die "ki läuft nur auf dem Host, nicht im Kerker (hier: Projekt $KI_PROJECT)."
fi
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
    "")              if [ -t 0 ] && [ -t 1 ] && [ -x "$SELF_DIR/ki-menu" ]; then exec "$SELF_DIR/ki-menu"; fi
                     cmd_help ;;
    new)             cmd_new "$@" ;;
    open)            cmd_open "$@" ;;
    shell|sh)        cmd_shell "$@" ;;
    run)             cmd_run "$@" ;;
    jobs)            cmd_jobs "$@" ;;
    logs|log)        cmd_logs "$@" ;;
    stop)            cmd_stop "$@" ;;
    jupyter)         cmd_jupyter "$@" ;;
    list|ls)         cmd_list "$@" ;;
    caches)          cmd_caches "$@" ;;
    clean)           cmd_clean "$@" ;;
    rm)              cmd_rm "$@" ;;
    mv|rename)       cmd_mv "$@" ;;
    migrate)         cmd_migrate "$@" ;;
    status)          cmd_status "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    power)           cmd_power "$@" ;;
    top)             cmd_top ;;
    update)          cmd_update ;;
    pycharm-update)  cmd_pycharm_update "$@" ;;
    menu)            exec "$SELF_DIR/ki-menu" ;;
    version|--version) echo "ki $KI_VERSION" ;;
    help|-h|--help)  cmd_help ;;
    _ide)            cmd__ide "$@" ;;
    _job)            cmd__job "$@" ;;
    _state)          cmd__state ;;
    _lastcmd)        cmd__lastcmd "$@" ;;
    *)               die "Unbekannter Befehl '$cmd' – Übersicht: ki help" ;;
esac
