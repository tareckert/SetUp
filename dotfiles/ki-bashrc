# ~/.config/ki/bashrc – KI-Workstation, Host-Shell (wird aus ~/.bashrc geladen)
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH" ;; esac
if [ -d /usr/local/cuda/bin ]; then
    case ":$PATH:" in *":/usr/local/cuda/bin:"*) ;; *) PATH="$PATH:/usr/local/cuda/bin" ;; esac
fi
export PATH

# Tab-Vervollständigung für ki: Befehle und Projektnamen
_ki_complete() {
    local cur=${COMP_WORDS[COMP_CWORD]} projects
    if [ "$COMP_CWORD" -eq 1 ]; then
        mapfile -t COMPREPLY < <(compgen -W "new open shell run jobs logs stop jupyter list clean rm mv migrate status doctor power top update pycharm-update help" -- "$cur")
    elif [ "$COMP_CWORD" -eq 2 ]; then
        case ${COMP_WORDS[1]} in
            open|shell|run|jobs|logs|stop|jupyter|clean|rm|mv|migrate|caches)
                projects=$(find "${KI_PROJECTS:-$HOME/projects}" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null)
                mapfile -t COMPREPLY < <(compgen -W "$projects" -- "$cur") ;;
            power) mapfile -t COMPREPLY < <(compgen -W "performance balanced" -- "$cur") ;;
        esac
    fi
}
complete -F _ki_complete ki
