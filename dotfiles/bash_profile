# ~/.bash_profile – KI-Workstation
# Normale Login-Umgebung laden: PATH mit ~/bin, ~/.bashrc für interaktive Shells.
# (Ohne diese Zeile ignoriert bash ~/.profile, sobald ~/.bash_profile existiert.)
# shellcheck source=/dev/null
[ -f "$HOME/.profile" ] && . "$HOME/.profile"

# Oberfläche nur auf tty1 und nur ohne laufendes X – SSH-Sitzungen starten nie X.
# Notausgang: in den 2 Sekunden eine Taste drücken → Konsole statt Oberfläche
# (oder dauerhaft: touch ~/.ki-no-x). Ohne "exec": stürzt X ab, bleibt die Konsole.
if [ -z "${DISPLAY:-}" ] && [ "$(tty)" = "/dev/tty1" ] && [ ! -e "$HOME/.ki-no-x" ]; then
    printf '\n  KI-Workstation startet … (Taste = Konsole statt Oberfläche)\n'
    if read -r -s -n 1 -t 2 _; then
        printf '  Konsole. Oberfläche starten mit: startx\n\n'
    else
        mkdir -p "$HOME/.local/state/ki"
        startx >"$HOME/.local/state/ki/xsession.log" 2>&1
        printf '\n  Oberfläche beendet – Log: ~/.local/state/ki/xsession.log\n  Neu starten: startx\n\n'
    fi
fi
