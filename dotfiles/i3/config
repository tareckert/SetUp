# ~/.config/i3/config – KI-Workstation
#
# Mod-Taste ist die Win-/Super-Taste (Mod4). Alt (Mod1) kollidiert mit PyCharm:
# Alt+Enter (Quick-Fix), Alt+1 (Projektfenster), Alt+F7 (Verwendungen) …
set $mod Mod4
font pango:DejaVu Sans Mono 10

# Arbeitsflächen: 1 = Menü, 2 = PyCharm, 3 = Extra (Jupyter, Monitor, Terminals)
assign [instance="^ki-menu$"]  number 1
assign [class="^jetbrains-"]   number 2
assign [instance="^ki-extra$"] number 3
workspace_auto_back_and_forth yes
focus_on_window_activation smart

default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
for_window [instance="^ki-menu$"] border pixel 0

# Darcula
client.focused          #CC7832 #CC7832 #2B2B2B #CC7832 #CC7832
client.focused_inactive #3C3F41 #3C3F41 #A9B7C6 #3C3F41 #3C3F41
client.unfocused        #2B2B2B #2B2B2B #808080 #2B2B2B #2B2B2B
client.urgent           #F2777A #F2777A #2B2B2B #F2777A #F2777A
client.background       #2B2B2B

bindsym $mod+Return       exec urxvt
bindsym $mod+g            exec urxvt -name ki-extra -title GPU-Monitor -e "$HOME/bin/ki" top
bindsym $mod+Shift+q      kill
bindsym $mod+f            fullscreen toggle
bindsym $mod+Shift+space  floating toggle
bindsym $mod+Left         focus left
bindsym $mod+Right        focus right
bindsym $mod+Up           focus up
bindsym $mod+Down         focus down
bindsym $mod+1            workspace number 1
bindsym $mod+2            workspace number 2
bindsym $mod+3            workspace number 3
bindsym $mod+4            workspace number 4
bindsym $mod+Shift+1      move container to workspace number 1
bindsym $mod+Shift+2      move container to workspace number 2
bindsym $mod+Shift+3      move container to workspace number 3
bindsym $mod+Shift+4      move container to workspace number 4
bindsym $mod+Tab          workspace back_and_forth
bindsym $mod+Shift+r      restart
# Bewusst keine Taste für "i3 beenden": ein Fehlgriff würde PyCharm mitreißen.

bar {
    status_command exec "$HOME/bin/ki-status"
    position bottom
    tray_output none
    colors {
        background #2B2B2B
        statusline #A9B7C6
        separator  #555555
        focused_workspace  #CC7832 #CC7832 #2B2B2B
        active_workspace   #3C3F41 #3C3F41 #A9B7C6
        inactive_workspace #2B2B2B #2B2B2B #808080
        urgent_workspace   #F2777A #F2777A #2B2B2B
    }
}

exec --no-startup-id xsetroot -solid "#2B2B2B"
# Menü: kommt nach dem Schließen nach 1 s wieder. Stürzt es ab, bleibt eine Shell im
# Fenster stehen (exit = Menü neu starten) – nie ein leerer Bildschirm.
exec --no-startup-id sh -c 'while :; do urxvt -name ki-menu -e sh -c "\"\$HOME/bin/ki-menu\" || { echo; echo \"Menü beendet – Shell (exit = Menü neu starten)\"; exec bash; }"; sleep 1; done'
